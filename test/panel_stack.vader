" Tests for sharing one sidebar column with NERDTree.
"
" NERDTree cannot be driven from a scripted Vim — `silent NERDTree` deadlocks
" and even a bare invocation often fails to return — so these tests stub its
" API (g:NERDTree.IsOpen / GetWinNum / t:NERDTreeBufName) and stand in for its
" window with a structurally identical one: a left-anchored, width-fixed
" scratch split. What is exercised is the plugin's own logic, not NERDTree.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  let g:_store_dir = tempname()
  call mkdir(g:_store_dir, 'p')
  call kimi#store#_set_root(g:_store_dir)
  call kimi#cli#_set_cmd('sleep 30')
  " Pin the panel's stacked height to a line count: the built-in percentage
  " would track the test runner's screen size.
  call kimi#sidebar#_set_heights(0, 15)
  call kimi#store#_reset()
  " Room for the geometry the tests assert against.
  let g:_saved_lines = [&lines, &columns]
  set lines=40 columns=120

  " A stand-in for NERDTree's window.
  function! FakeTree() abort
    topleft vertical 31split
    enew
    setlocal buftype=nofile bufhidden=wipe noswapfile winfixwidth
    silent! file fake-nerdtree
    let t:NERDTreeBufName = 'fake-nerdtree'
    let g:_fake_win = win_getid()
    return g:_fake_win
  endfunction

  function! CloseFakeTree() abort
    if exists('g:_fake_win') && win_id2win(g:_fake_win) > 0
      let l:id = g:_fake_win
      unlet g:_fake_win
      call win_execute(l:id, 'close')
      call kimi#panel#_win_closed(l:id)
    endif
    unlet! g:_fake_win
    unlet! t:NERDTreeBufName
  endfunction

  " Stub NERDTree's public API against that window.
  let g:NERDTree = {}
  function! g:NERDTree.IsOpen() abort
    return exists('g:_fake_win') && win_id2win(g:_fake_win) > 0
  endfunction
  function! g:NERDTree.GetWinNum() abort
    return exists('g:_fake_win') ? win_id2win(g:_fake_win) : -1
  endfunction

  " Panel window above the sidebar window, in one column?
  function! Stacked() abort
    let l:p = bufwinid(kimi#panel#bufnr())
    let l:n = get(g:, '_fake_win', -1)
    if l:p <= 0 || l:n <= 0 | return 0 | endif
    let l:pp = win_screenpos(win_id2win(l:p))
    let l:np = win_screenpos(win_id2win(l:n))
    return l:pp[1] == l:np[1] && l:pp[0] < l:np[0]
  endfunction

After:
  execute 'set lines=' . g:_saved_lines[0] . ' columns=' . g:_saved_lines[1]
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#cli#_reset()
  unlet! g:NERDTree
  unlet! g:_fake_win
  unlet! t:NERDTreeBufName
  call kimi#store#_reset()
  call delete(g:_store_dir, 'rf')
  silent! only

" ── stacking ─────────────────────────────────────────────────────────────────

Execute (sidebar first, then the panel: they share one column):
  call FakeTree()
  call kimi#panel#open()
  Assert Stacked(), 'the panel should sit above the sidebar in one column'

Execute (panel first, then the sidebar: stack() repairs the layout):
  call kimi#panel#open()
  call FakeTree()
  " NERDTree would fire NERDTreeInit here; call the repair pass directly.
  call kimi#panel#stack()
  Assert Stacked(), 'the panel should be moved above the sidebar'

Execute (the panel is on top regardless of which opened first):
  call kimi#panel#open()
  call FakeTree()
  call kimi#panel#stack()
  let ppos = win_screenpos(win_id2win(bufwinid(kimi#panel#bufnr())))
  let npos = win_screenpos(win_id2win(g:_fake_win))
  Assert ppos[0] < npos[0], 'panel row must be above the sidebar row'

Execute (stacking is idempotent):
  call FakeTree()
  call kimi#panel#open()
  let before = winlayout()
  call kimi#panel#stack()
  call kimi#panel#stack()
  AssertEqual before, winlayout(), 'repeated stacking must not churn windows'

" ── sizing ───────────────────────────────────────────────────────────────────

Execute (the panel takes its height and the sidebar the rest):
  call kimi#sidebar#_set_heights(0, 12)
  call FakeTree()
  call kimi#panel#open()
  AssertEqual 12, winheight(win_id2win(bufwinid(kimi#panel#bufnr())))
  Assert winheight(win_id2win(g:_fake_win)) > 0,
        \ 'the sidebar keeps the remaining lines'
  call kimi#sidebar#_set_heights(0, 15)

Execute (the panel is height-fixed while stacked):
  call FakeTree()
  call kimi#panel#open()
  AssertEqual 1, getwinvar(win_id2win(bufwinid(kimi#panel#bufnr())),
        \ '&winfixheight')

Execute (a standalone panel is not height-fixed):
  call kimi#panel#open()
  AssertEqual 0, getwinvar(win_id2win(bufwinid(kimi#panel#bufnr())),
        \ '&winfixheight'),
        \ 'without a sidebar the panel must not be pinned to a height'

Execute (closing the sidebar releases the panel height):
  call FakeTree()
  call kimi#panel#open()
  AssertEqual 1, getwinvar(win_id2win(bufwinid(kimi#panel#bufnr())),
        \ '&winfixheight')
  call CloseFakeTree()
  " The WinClosed hook defers its work to a timer.
  sleep 100m
  AssertEqual 0, getwinvar(win_id2win(bufwinid(kimi#panel#bufnr())),
        \ '&winfixheight'),
        \ 'the panel should reclaim the column when the sidebar goes'

" ── sessions never open into a sidebar ───────────────────────────────────────

Execute (a session opens beside the sidebars, not inside them):
  call FakeTree()
  call kimi#panel#open()
  let id = kimi#session#new('somewhere else')
  call win_execute(bufwinid(kimi#session#get(id).bufnr), 'hide')
  call kimi#panel#open_session(id, 'split')
  let twin = bufwinid(kimi#session#get(id).bufnr)
  Assert twin != -1, 'the session should be visible'
  Assert win_screenpos(win_id2win(twin))[1]
        \ > win_screenpos(win_id2win(g:_fake_win))[1],
        \ 'the session must open to the right of the sidebar column'
  Assert win_id2win(g:_fake_win) > 0, 'the sidebar must survive'

Execute (the sidebar is not counted as an ordinary window on quit):
  call FakeTree()
  call kimi#panel#open()
  AssertEqual bufnr('fake-nerdtree'), kimi#panel#nerdtree_bufnr()
  Assert index(kimi#session#bufnrs(), kimi#panel#nerdtree_bufnr()) == -1

" ── no visible flash ─────────────────────────────────────────────────────────
"
" NERDTreeInit fires at the end of Creator.createTabTree(), once the window is
" built, so the repair must happen inside the hook rather than on a timer —
" otherwise Vim redraws the two columns side by side before they snap together.

Execute (the init hook stacks immediately, without waiting for a timer):
  call kimi#panel#open()
  call FakeTree()
  Assert !Stacked(), 'precondition: the sidebar opens as its own column'
  call kimi#panel#_nerdtree_init()
  " Deliberately no sleep: this must be done by the time the hook returns.
  Assert Stacked(), 'the init hook must stack synchronously'

Execute (stacking leaves the cursor where it was):
  call kimi#panel#open()
  let treewin = FakeTree()
  call win_gotoid(treewin)
  call kimi#panel#_nerdtree_init()
  AssertEqual treewin, win_getid(),
        \ ':NERDTree must keep focus after the panel is moved'

Execute (opening the panel onto an existing sidebar stacks before rendering):
  call FakeTree()
  call kimi#panel#open()
  Assert Stacked(), 'the panel should already be in place when open() returns'

" ── repairing an independently-opened NERDTree ───────────────────────────────
"
" When NERDTree is opened by its own command the plugin does not drive the
" sequence, so the repair has to run as early as NERDTree can be identified.
" FileType fires from the last line of Creator._setCommonBufOptions() — after
" the window is sized, before the tree is built or rendered.

Execute (the window is found while NERDTree is still being built):
  " Mid-creation b:NERDTree does not exist yet, so ExistsForTab() would be
  " false; the lookup must go through t:NERDTreeBufName instead.
  call kimi#panel#open()
  call FakeTree()
  unlet! g:NERDTree
  call kimi#panel#_nerdtree_init()
  Assert Stacked(), 'the sidebar must be found without g:NERDTree being usable'

Execute (a FileType nerdtree event repairs the layout):
  call kimi#panel#open()
  call FakeTree()
  Assert !Stacked(), 'precondition: the sidebar opened as its own column'
  " Stand in for the event NERDTree fires from _setCommonBufOptions().
  doautocmd FileType nerdtree
  Assert Stacked(), 'FileType nerdtree should trigger the repair'

Execute (the repair keeps the cursor in the tree window mid-creation):
  call kimi#panel#open()
  let treewin = FakeTree()
  call win_gotoid(treewin)
  doautocmd FileType nerdtree
  AssertEqual treewin, win_getid(),
        \ 'NERDTree must keep focus so it can finish building itself'

Execute (repeated events do not churn the layout):
  call kimi#panel#open()
  call FakeTree()
  doautocmd FileType nerdtree
  let settled = winlayout()
  doautocmd FileType nerdtree
  call kimi#panel#_nerdtree_init()
  AssertEqual settled, winlayout()

" ── manual resizing is not undone ────────────────────────────────────────────
"
" The starting height is a starting height, not one that gets re-imposed:
" kimi#panel#stack() runs from the poll timer, so re-applying the height on
" every call would fight the user every couple of seconds.

Execute (a hand-resized panel keeps its height across a stack() call):
  call FakeTree()
  call kimi#panel#open()
  AssertEqual 15, winheight(win_id2win(bufwinid(kimi#panel#bufnr())))
  " The user drags the divider.
  call win_execute(bufwinid(kimi#panel#bufnr()), 'resize 25')
  AssertEqual 25, winheight(win_id2win(bufwinid(kimi#panel#bufnr())))
  " Two poll ticks later it must still be 25.
  call kimi#panel#stack()
  call kimi#panel#stack()
  AssertEqual 25, winheight(win_id2win(bufwinid(kimi#panel#bufnr()))),
        \ 'the poll timer must not re-impose the starting height'

Execute (the height is still applied when the two first come together):
  call kimi#panel#open()
  call FakeTree()
  call kimi#panel#_nerdtree_init()
  AssertEqual 15, winheight(win_id2win(bufwinid(kimi#panel#bufnr()))),
        \ 'the starting height applies on the transition into stacking'

Execute (re-stacking after a manual unstack applies the height again):
  call FakeTree()
  call kimi#panel#open()
  call win_execute(bufwinid(kimi#panel#bufnr()), 'resize 25')
  " Pull the panel back out into its own column, as a manual rearrangement would.
  call win_splitmove(bufwinid(kimi#panel#bufnr()), g:_fake_win,
        \ {'vertical': v:true, 'rightbelow': v:false})
  Assert !Stacked(), 'precondition: the panel is out of the column'
  call kimi#panel#stack()
  Assert Stacked(), 'the backstop should put it back'
  AssertEqual 15, winheight(win_id2win(bufwinid(kimi#panel#bufnr())))
