" Tests for the tail the panel buries — the finished sessions nobody has a
" label for, and the finished sessions nobody has touched for two days — and
" for the I toggle that reveals them. No terminal, no jobs.
"
" Most of these are about the labelling rule, so fixtures are stamped recent
" and the staleness rule is exercised on its own at the bottom of the file.

Before:
  call kimi#session#_reset()
  call kimi#store#_reset()
  let g:_saved_cwd   = getcwd()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  let g:_dir = resolve(g:_dir)
  call kimi#store#_set_root(g:_dir)
  execute 'cd ' . fnameescape(g:_dir)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call kimi#session#_reset()
  call kimi#store#_reset()
  call delete(g:_dir, 'rf')

" ── the filter ───────────────────────────────────────────────────────────────

Execute (an unlabelled session is left out of the list):
  call kimi#session#_inject({'id': 'aaa', 'name': 'panel design'})
  call kimi#session#_inject({'id': 'bbb', 'name': '', 'named': 0})
  let ids = map(copy(kimi#session#list()), {_, r -> r.id})
  AssertEqual ['aaa'], ids

Execute (the toggle reveals it, and puts it away again):
  call kimi#session#_inject({'id': 'aaa', 'name': 'panel design'})
  call kimi#session#_inject({'id': 'bbb', 'name': '', 'named': 0})

  AssertEqual 1, kimi#session#toggle_hidden()
  Assert kimi#session#show_hidden(), 'hidden sessions should be shown'
  let ids = sort(map(copy(kimi#session#list()), {_, r -> r.id}))
  AssertEqual ['aaa', 'bbb'], ids

  AssertEqual 0, kimi#session#toggle_hidden()
  AssertEqual ['aaa'], map(copy(kimi#session#list()), {_, r -> r.id})

Execute (a live session is never hidden, labelled or not):
  call kimi#session#_inject(
        \ {'id': 'bbb', 'name': '', 'named': 0, 'status': 'active'})
  AssertEqual ['bbb'], map(copy(kimi#session#list()), {_, r -> r.id}),
        \ 'an unlabelled session that is running is the last thing to hide'
  AssertEqual 1, len(kimi#session#live())

Execute (the same session is hidden once it finishes):
  call kimi#session#_inject(
        \ {'id': 'bbb', 'name': '', 'named': 0, 'status': 'closed'})
  AssertEqual [], kimi#session#list()
  AssertEqual 1, len(kimi#session#all()),
        \ 'all() is the unfiltered view: the resume picker still sees it'

Execute (an injected record is named unless it says otherwise):
  call kimi#session#_inject({'id': 'aaa', 'name': 'panel design'})
  AssertEqual 1, len(kimi#session#list())

" ── the tree ─────────────────────────────────────────────────────────────────

Execute (a branch group whose sessions are all hidden is not built):
  call kimi#session#_inject({'id': 'aaa', 'name': 'named one',
        \ 'project': '/p', 'worktree': '/p', 'branch': 'main'})
  call kimi#session#_inject({'id': 'bbb', 'name': '', 'named': 0,
        \ 'project': '/p', 'worktree': '/p', 'branch': 'sidebar'})

  let tree = kimi#session#tree()
  AssertEqual 1, len(tree)
  let branches = map(copy(tree[0].branches), {_, b -> b.label})
  AssertEqual ['main'], branches

  call kimi#session#toggle_hidden()
  let tree = kimi#session#tree()
  let branches = sort(map(copy(tree[0].branches),
        \ {_, b -> b.label}))
  AssertEqual ['main', 'sidebar'], branches

" ── labels ───────────────────────────────────────────────────────────────────

Execute (an unlabelled session is labelled by its id):
  let rec = {'id': 'abcdef0123456789', 'name': ''}
  AssertEqual '(unnamed abcdef01)', kimi#session#label(rec)

Execute (a named session is labelled by its name):
  AssertEqual 'panel design',
        \ kimi#session#label({'id': 'aaa', 'name': 'panel design'})

Execute (naming a session is what un-hides it):
  call kimi#session#_inject({'id': 'bbb', 'name': '', 'named': 0})
  AssertEqual [], kimi#session#list()
  call kimi#session#rename('bbb', 'given a name')
  AssertEqual ['bbb'], map(copy(kimi#session#list()), {_, r -> r.id})

" ── the store ────────────────────────────────────────────────────────────────

Execute (a stored entry from before the flag existed counts as named):
  call kimi#store#save({'version': 1, 'sessions':
        \ {'old': {'name': 'named yesterday', 'cwd': getcwd(),
        \          'created': localtime()}}})
  call kimi#session#refresh()
  AssertEqual ['old'], map(copy(kimi#session#list()), {_, r -> r.id})

Execute (a stored entry that was never named stays hidden):
  call kimi#store#save({'version': 1, 'sessions':
        \ {'auto': {'name': '', 'named': 0, 'cwd': getcwd(),
        \           'created': localtime()}}})
  call kimi#session#refresh()
  AssertEqual [], kimi#session#list()
  call kimi#session#toggle_hidden()
  AssertEqual ['auto'], map(copy(kimi#session#list()), {_, r -> r.id})

Execute (a stored entry remembers the workspace it ran in):
  call kimi#store#save({'version': 1, 'sessions':
        \ {'ws': {'name': 'in a worktree', 'named': 1, 'workspace': 'feature',
        \         'cwd': getcwd(), 'created': localtime()}}})
  call kimi#session#refresh()
  AssertEqual 'feature', kimi#session#get('ws').workspace

Execute (a reset puts the toggle back):
  call kimi#session#toggle_hidden()
  call kimi#session#_reset()
  Assert !kimi#session#show_hidden()

" ── the staleness rule ───────────────────────────────────────────────────────
"
" A finished session is buried once nobody has touched it for two days,
" whoever labelled it.

Execute (a named session finished days ago is buried):
  call kimi#session#_inject({'id': 'old', 'name': 'last week',
        \ 'status': 'closed', 'created': localtime() - 9 * 86400})
  AssertEqual [], kimi#session#list()
  call kimi#session#toggle_hidden()
  AssertEqual ['old'], map(copy(kimi#session#list()), {_, r -> r.id}),
        \ 'I reveals the stale ones too'

Execute (a named session finished this morning is not):
  call kimi#session#_inject({'id': 'new', 'name': 'this morning',
        \ 'status': 'closed', 'created': localtime() - 3600})
  AssertEqual ['new'], map(copy(kimi#session#list()), {_, r -> r.id})

Execute (opening a session is what keeps it out of the tail):
  call kimi#session#_inject({'id': 'old', 'name': 'made long ago',
        \ 'status': 'closed', 'created': localtime() - 9 * 86400,
        \ 'last_focus': localtime() - 600})
  AssertEqual ['old'], map(copy(kimi#session#list()), {_, r -> r.id}),
        \ 'age is measured from the last time it was opened'

Execute (a stale session that is running again is listed):
  call kimi#session#_inject({'id': 'old', 'name': 'back from the dead',
        \ 'status': 'active', 'created': localtime() - 9 * 86400})
  AssertEqual ['old'], map(copy(kimi#session#list()), {_, r -> r.id})
