" End-to-end tests for the branch/name prompts and the workspace a session
" ends up running in. Real git worktrees, real terminal jobs, prompts answered
" with feedkeys(); the CLI itself is stood in for via a fixture
" $KIMI_CODE_HOME.

Before:
  call kimi#session#_reset()
  call kimi#workspace#_reset()
  call kimi#store#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  let g:_saved_cwd = getcwd()
  let g:_root = tempname()
  call mkdir(g:_root, 'p')
  let g:_root = resolve(g:_root)
  let g:_repo = g:_root . '/repo'
  call mkdir(g:_repo, 'p')
  let g:_git = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_git . 'init -q -b main')
  call system(g:_git . 'config user.email t@t')
  call system(g:_git . 'config user.name test')
  call writefile(['hello'], g:_repo . '/file.txt')
  call system(g:_git . 'add -A')
  call system(g:_git . 'commit -qm first')
  call system(g:_git . 'branch feature-branch')
  call kimi#store#_set_root(g:_root)
  let g:_home = g:_root . '/kimi-home'
  call mkdir(g:_home, 'p')
  let $KIMI_CODE_HOME = g:_home
  call kimi#cli#_set_cmd('sleep 30')
  execute 'cd ' . fnameescape(g:_repo)

After:
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call kimi#session#_reset()
  call kimi#workspace#_reset()
  call kimi#store#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  let $KIMI_CODE_HOME = ''
  call delete(g:_root, 'rf')
  only

Execute (branch + blank name: a worktree is created and the session runs in it):
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  let id = kimi#session#new('', '')
  Assert !empty(id), 'a session should have started'
  let rec = kimi#session#get(id)
  AssertEqual 'feature-branch', rec.name, 'named after the branch'
  AssertEqual 'feature-branch', rec.workspace
  AssertEqual g:_root . '/repo-feature-branch', rec.cwd
  AssertEqual 'feature-branch', rec.branch, 'grouped under the branch'
  AssertEqual g:_repo, rec.project, 'grouped under the main repo'
  Assert isdirectory(rec.cwd), 'the worktree should exist'
  AssertEqual 'run', job_status(term_getjob(rec.bufnr))
  AssertEqual 1, len(kimi#session#list()), 'it is listed'

Execute (the job itself is started in the worktree, not in Vim's directory):
  " /bin/pwd reports the directory the process was actually given.
  call kimi#cli#_set_cmd('/bin/pwd')
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  let id = kimi#session#new('', '')
  let bufnr = kimi#session#get(id).bufnr
  " A path wider than the terminal wraps, so read the first rows as one.
  let printed = ''
  for _ in range(50)
    let printed = ''
    for row in range(1, 3)
      let printed .= term_getline(bufnr, row)
    endfor
    let printed = trim(printed)
    if !empty(printed)
      break
    endif
    sleep 20m
  endfor
  AssertEqual g:_root . '/repo-feature-branch', printed

Execute (a typed session name does not rename the workspace):
  " The workspace directory is always <project>-<branch>: what the user types
  " at the "Session name" prompt only labels the session.
  call feedkeys("feature-branch\<CR>my session\<CR>", 't')
  let id = kimi#session#new('', '')
  let rec = kimi#session#get(id)
  AssertEqual 'my session',     rec.name
  AssertEqual 'feature-branch', rec.workspace
  AssertEqual g:_root . '/repo-feature-branch', rec.cwd

Execute (two sessions on different branches keep their own workspaces):
  call system(g:_git . 'branch second')
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  call kimi#session#new('', '')
  call feedkeys("second\<CR>\<CR>", 't')
  let id = kimi#session#new('', '')
  AssertEqual 'second', kimi#session#get(id).workspace
  AssertEqual 'second', kimi#session#get(id).name

Execute (both blank: no worktree, unnamed, hidden from the panel):
  call feedkeys("\<CR>\<CR>", 't')
  let id = kimi#session#new('', '')
  let rec = kimi#session#get(id)
  AssertEqual '', rec.name
  AssertEqual '', rec.workspace
  AssertEqual 0,  rec.named
  AssertEqual g:_repo, rec.cwd, 'it runs where Vim already was'
  AssertEqual [], kimi#workspace#list(), 'no worktree was created'
  " It is running, so it is listed even though nobody named it: it will label
  " itself from its first prompt, and be buried once it has finished.
  AssertEqual [id], map(copy(kimi#session#list()), {_, r -> r.id})
  call kimi#session#delete(id)
  AssertEqual [], kimi#session#list(), 'finished and nameless: hidden'

Execute (name only: no worktree, but listed):
  call feedkeys("\<CR>just a name\<CR>", 't')
  let id = kimi#session#new('', '')
  let rec = kimi#session#get(id)
  AssertEqual 'just a name', rec.name
  AssertEqual '',            rec.workspace
  AssertEqual g:_repo,       rec.cwd
  AssertEqual [id], map(copy(kimi#session#list()), {_, r -> r.id})

Execute (a selected workspace is where a branch-less session runs):
  let ws = kimi#workspace#create('feature-branch', '')
  call kimi#workspace#set_current('feature-branch')
  call feedkeys("\<CR>in the workspace\<CR>", 't')
  let id = kimi#session#new('', '')
  AssertEqual ws.path, kimi#session#get(id).cwd
  AssertEqual '', kimi#session#get(id).workspace,
        \ 'it borrows the workspace rather than owning one'

Execute (the panel groups a workspace session under its own worktree):
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  call kimi#session#new('', '')
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  let lines = join(kimi#panel#_lines(), "\n")
  Assert lines =~# 'repo-feature-branch', 'the worktree node should appear'
  Assert lines =~# 'feature-branch', 'the branch node should appear'

Execute (resuming puts the session back in its workspace):
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  let id = kimi#session#new('', '')
  let dir = kimi#session#get(id).cwd
  call kimi#session#delete(id)
  AssertEqual 'closed', kimi#session#status(id)
  " Resume into a window of its own: taking over this one would fail on the
  " modified scratch buffer the test harness is sitting in.
  call kimi#session#resume(id, 'new')
  let bufnr = kimi#session#get(id).bufnr
  Assert bufnr != -1, 'the session should be live again'
  AssertEqual dir, kimi#session#get(id).cwd

Execute (the main checkout's branch runs the session there, not in a worktree):
  call feedkeys("main\<CR>named anyway\<CR>", 't')
  let id = kimi#session#new('', '')
  let rec = kimi#session#get(id)
  AssertEqual 'named anyway', rec.name
  AssertEqual '',      rec.workspace, 'the main checkout is not a workspace'
  AssertEqual g:_repo, rec.cwd
  AssertEqual 'main',  rec.branch

Execute (a branch whose workspace exists runs the session in that workspace):
  " Exactly the case of asking twice for one branch: the second session
  " belongs in the worktree the first one made, not back in the main checkout.
  let ws = kimi#workspace#create('feature-branch', '')
  call feedkeys("feature-branch\<CR>blah\<CR>", 't')
  let id = kimi#session#new('', '')
  let rec = kimi#session#get(id)
  AssertEqual 'blah',           rec.name
  AssertEqual ws.id,            rec.workspace, 'it joins the workspace'
  AssertEqual ws.path,          rec.cwd
  AssertEqual 'feature-branch', rec.branch,
        \ 'and is grouped under its own branch, not the one Vim is on'
  AssertEqual 1, len(kimi#workspace#list()),
        \ 'no second worktree was made for the same branch'

" ── surviving a restart ──────────────────────────────────────────────────────
"
" The CLI files a session under the directory a session ran in, and a
" workspace session runs in its own worktree. Both halves of the registry —
" the store and the CLI's session index — have to look past the directory Vim
" happens to be in, or the session vanishes the next time you open Vim in the
" repo.

Execute (a workspace session is still listed after Vim restarts in the repo):
  call feedkeys("feature-branch\<CR>diff tree work\<CR>", 't')
  let id = kimi#session#new('', '')
  " The workspace is named after the branch, whatever the session was called.
  AssertEqual 'feature-branch', kimi#session#get(id).workspace

  " Restart: drop every in-memory record, keep what is on disk.
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#session#_reset()
  call kimi#cli#_set_cmd('sleep 30')
  call kimi#store#_reset()
  call kimi#session#refresh()

  let recs = kimi#session#list()
  AssertEqual 1, len(recs), 'the session should have come back'
  AssertEqual 'diff tree work', recs[0].name
  AssertEqual 'feature-branch', recs[0].workspace
  AssertEqual g:_root . '/repo-feature-branch', recs[0].cwd

Execute (it comes back grouped under its own workspace):
  call feedkeys("feature-branch\<CR>diff tree work\<CR>", 't')
  call kimi#session#new('', '')
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#session#_reset()
  call kimi#cli#_set_cmd('sleep 30')
  call kimi#store#_reset()
  call kimi#session#refresh()

  let tree = kimi#session#tree()
  AssertEqual 1, len(tree)
  AssertEqual g:_root . '/repo-feature-branch', tree[0].path,
        \ 'the workspace gets its own top-level group, not the main checkout'
  AssertEqual 'feature-branch', tree[0].branches[0].label
  AssertEqual g:_root . '/repo-feature-branch', tree[0].branches[0].path

Execute (the branch row is named after the real branch, not the slugified workspace name):
  call system(g:_git . 'branch pedro.cordeiro/macos-fleet-config')
  call feedkeys("pedro.cordeiro/macos-fleet-config\<CR>\<CR>", 't')
  call kimi#session#new('', '')
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#session#_reset()
  call kimi#cli#_set_cmd('sleep 30')
  call kimi#store#_reset()
  call kimi#session#refresh()

  let tree = kimi#session#tree()
  AssertEqual 1, len(tree)
  Assert tree[0].path =~# 'pedro.cordeiro-macos-fleet-config$',
        \ 'the workspace directory is slugified: ' . tree[0].path
  AssertEqual 'pedro.cordeiro/macos-fleet-config', tree[0].branches[0].label,
        \ 'the branch row should show the real branch, slash and all'

Execute (a CLI session written in the workspace is found from the main checkout):
  let ws = kimi#workspace#create('feature-branch', '')
  let dir = g:_home . '/sessions/wd_x/ses-from-cli'
  call mkdir(dir . '/agents/main', 'p')
  call writefile([json_encode({'sessionId': 'ses-from-cli',
        \ 'sessionDir': dir, 'workDir': ws.path})],
        \ g:_home . '/session_index.jsonl')
  call writefile([json_encode({'id': 'ses-from-cli',
        \ 'title': 'rework the diff tree', 'isCustomTitle': 1,
        \ 'lastPrompt': 'rework the diff tree please',
        \ 'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})],
        \ dir . '/state.json')
  call kimi#cli#_reset()

  call kimi#session#refresh()
  let recs = kimi#session#list()
  AssertEqual 1, len(recs), 'the CLI session should have been picked up'
  AssertEqual ws.path,          recs[0].cwd
  AssertEqual 'feature-branch', recs[0].branch
  AssertEqual 'rework the diff tree', recs[0].name,
        \ 'the CLI title labels it'
  AssertEqual 'rework the diff tree', kimi#session#label(recs[0])
  AssertEqual 1, recs[0].named, 'a title is a label, so not buried'

Execute (a CLI session with no title falls back to its last prompt):
  let ws = kimi#workspace#create('feature-branch', '')
  let dir = g:_home . '/sessions/wd_x/ses-unlabeled'
  call mkdir(dir . '/agents/main', 'p')
  call writefile([json_encode({'sessionId': 'ses-unlabeled',
        \ 'sessionDir': dir, 'workDir': ws.path})],
        \ g:_home . '/session_index.jsonl')
  call writefile([json_encode({'id': 'ses-unlabeled', 'title': '',
        \ 'lastPrompt': 'what does this lever do',
        \ 'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})],
        \ dir . '/state.json')
  call kimi#cli#_reset()

  call kimi#session#refresh()
  call kimi#session#toggle_hidden()
  let recs = kimi#session#list()
  AssertEqual 1, len(recs), 'the CLI session should have been picked up'
  AssertEqual '', recs[0].name, 'no title, so no name'
  AssertEqual 'what does this lever do', recs[0].snippet
  AssertEqual 'what does this lever do', kimi#session#label(recs[0]),
        \ 'the last prompt labels it'
  AssertEqual 0, recs[0].named, 'never labelled, so hidden by default'

Execute (a session from another repository is not adopted):
  let other = g:_root . '/other'
  call mkdir(other, 'p')
  call system('git -C ' . shellescape(other) . ' init -q -b main')
  call kimi#store#save({'version': 1, 'sessions':
        \ {'elsewhere': {'name': 'not ours', 'named': 1, 'cwd': other,
        \                'project': other, 'created': 1}}})
  call kimi#session#refresh()
  AssertEqual [], kimi#session#list()

Execute (an old record with no project and another cwd is still skipped):
  call kimi#store#save({'version': 1, 'sessions':
        \ {'old': {'name': 'somewhere else', 'cwd': g:_root . '/nowhere',
        \          'created': 1}}})
  call kimi#session#refresh()
  AssertEqual [], kimi#session#list()

Execute (spawning without any prompt leaves the session nameless):
  let id = kimi#session#spawn({})
  let rec = kimi#session#get(id)
  AssertEqual '',      rec.name, 'nothing was asked, so nothing was named'
  AssertEqual 0,       rec.named
  AssertEqual '',      rec.workspace, 'and no branch was asked for either'
  AssertEqual g:_repo, rec.cwd
  AssertEqual [id], map(copy(kimi#session#list()), {_, r -> r.id}),
        \ 'running, so listed; nameless, so buried once it finishes'
  call kimi#session#delete(id)
  AssertEqual [], kimi#session#list()

Execute (a name passed as an argument still names the session):
  let id = kimi#session#new('from the command line', '')
  AssertEqual 'from the command line', kimi#session#get(id).name
  AssertEqual 1, kimi#session#get(id).named
  AssertEqual 1, len(kimi#session#list())

Execute (n starts a session in the workspace of the row under the cursor):
  call feedkeys("feature-branch\<CR>\<CR>", 't')
  let first = kimi#session#new('', '')
  let ws    = kimi#session#get(first).workspace
  Assert !empty(ws), 'the fixture session should have a workspace'

  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search(kimi#session#label(kimi#session#get(first)), 'W')
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)

  let ids = []
  for rec in kimi#session#live()
    if rec.id !=# first
      call add(ids, rec.id)
    endif
  endfor
  AssertEqual 1, len(ids), 'n should have started exactly one more'
  AssertEqual ws, kimi#session#get(ids[0]).workspace,
        \ 'a session started from a row lands where that row lives'
  AssertEqual kimi#session#get(first).cwd, kimi#session#get(ids[0]).cwd

Execute (n away from any session falls back to the selected workspace):
  let ws = kimi#workspace#create('feature-branch', '')
  call kimi#workspace#select(ws.id)
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)
  let live = kimi#session#live()
  AssertEqual 1, len(live)
  AssertEqual ws.id, live[0].workspace,
        \ 'with no row to read, <leader>kw decides'

" The session n just started: the live record that was not there before it was
" pressed. live()[0] cannot be trusted here — two sessions focused in the same
" second sort by name, and every session these tests start is unnamed.
Execute (helper):
  function! LiveIds() abort
    let out = []
    for rec in kimi#session#live()
      call add(out, rec.id)
    endfor
    return out
  endfunction

  function! Newcomer(before) abort
    for rec in kimi#session#live()
      if index(a:before, rec.id) < 0
        return rec
      endif
    endfor
    return {}
  endfunction

Execute (n from a branch row lands in that branch's workspace):
  " Two workspaces, so there is a wrong answer to give.
  call system(g:_git . 'branch other-branch')
  let a = kimi#workspace#create('feature-branch', '')
  let b = kimi#workspace#create('other-branch', '')
  call kimi#session#spawn({'workspace': a.id, 'placement': 'new'})
  call kimi#session#spawn({'workspace': b.id, 'placement': 'new'})

  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  " The branch row, not the group row above it whose path also says it.
  call search('^  ▾ other-branch$', 'W')
  Assert getline('.') =~# '^  ▾ other-branch$',
        \ 'expected the branch row: ' . getline('.')
  let before = LiveIds()
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)

  let new = Newcomer(before)
  AssertEqual b.id, new.workspace,
        \ 'a branch row means the workspace it belongs to'
  AssertEqual b.path, new.cwd

Execute (n from a workspace's group row lands there too):
  let ws = kimi#workspace#create('feature-branch', '')
  call kimi#session#spawn({'workspace': ws.id, 'placement': 'new'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('repo-feature-branch', 'W')
  let before = LiveIds()
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)
  AssertEqual ws.id, Newcomer(before).workspace

Execute (a session with no workspace of its own still lands in its worktree):
  let ws = kimi#workspace#create('feature-branch', '')
  " A record from before workspaces existed: it ran in the worktree but names
  " no workspace at all.
  call kimi#session#_inject({'id': 'old', 'name': 'legacy', 'workspace': '',
        \ 'status': 'closed', 'cwd': ws.path, 'project': g:_repo,
        \ 'worktree': ws.path, 'branch': 'feature-branch'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('legacy', 'W')
  let before = LiveIds()
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)
  let new = Newcomer(before)
  AssertEqual ws.path, new.cwd, 'the row it is drawn under is where it lives'
  AssertEqual ws.id,   new.workspace

Execute (n on the project row lands in the main checkout):
  let ws = kimi#workspace#create('feature-branch', '')
  call kimi#workspace#select(ws.id)
  call kimi#session#spawn({'workspace': ws.id, 'placement': 'new'})
  " A workspace session alone gets its own top-level group; a plain one
  " grounds the bare project row this test exercises.
  call kimi#session#_inject({'name': 'on main', 'status': 'idle',
        \ 'project': g:_repo, 'worktree': g:_repo, 'branch': 'main'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('^▾ repo$', 'W')
  let before = LiveIds()
  call kimi#panel#_set_ask_name(0)
  normal n
  call kimi#panel#_set_ask_name(1)
  AssertEqual g:_repo, Newcomer(before).cwd,
        \ 'the project row is the repository root, whatever is selected'
