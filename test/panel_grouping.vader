" Tests for g, the key that swaps the panel's top level between what sessions
" are doing and where they live, and for the fold state each view keeps.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#store#_reset()
  let g:_saved_cwd   = getcwd()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  call kimi#store#_set_root(g:_dir)
  execute 'cd ' . fnameescape(g:_dir)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#store#_reset()
  call delete(g:_dir, 'rf')
  only

Execute (helper):
  function! Panel() abort
    call kimi#session#_inject({'name': 'panel rework', 'status': 'active',
          \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
    call kimi#panel#open()
    call win_gotoid(bufwinid(kimi#panel#bufnr()))
  endfunction

" ── the swap ─────────────────────────────────────────────────────────────────

Execute (g swaps the top level, and back again):
  call Panel()
  Assert join(kimi#panel#_lines(), "\n") =~# '▾ Working',
        \ 'the panel opens on the state view'

  normal g
  AssertEqual 'place', kimi#panel#_grouping()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▾ alpha',      'now it is the place view: ' . text
  Assert text =~# '  ▾ main',   'and its branch'
  Assert text !~# 'Working',      'and no state groups'

  normal g
  AssertEqual 'state', kimi#panel#_grouping()
  Assert join(kimi#panel#_lines(), "\n") =~# '▾ Working'

Execute (the same session is drawn in both, at different depths):
  call Panel()
  let state = filter(kimi#panel#_lines(), {_, l -> l =~# 'panel rework'})[0]
  normal g
  let place = filter(kimi#panel#_lines(), {_, l -> l =~# 'panel rework'})[0]
  Assert state =~# '^  ●',     'two indents in the state view: ' . state
  Assert place =~# '^    ●', 'four in the place view: ' . place

Execute (the header follows you across):
  call kimi#session#_inject({'name': 'asking', 'status': 'waiting'})
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  Assert kimi#panel#_lines()[0] =~# '1 waiting$'
  normal g
  Assert kimi#panel#_lines()[0] =~# '1 waiting$',
        \ 'who needs you is the question in either view'

" ── folds ────────────────────────────────────────────────────────────────────

Execute (each view keeps its own folds across a swap):
  call Panel()
  " Fold the Working group in the state view.
  call cursor(1, 1)
  call search('Working', 'W')
  normal za
  Assert join(kimi#panel#_lines(), "\n") !~# 'panel rework'

  " The place view is unaffected: its keys are its own.
  normal g
  Assert join(kimi#panel#_lines(), "\n") =~# 'panel rework',
        \ 'a state fold must not fold a project'

  " Fold the project too.
  call cursor(1, 1)
  call search('alpha', 'W')
  normal za
  Assert join(kimi#panel#_lines(), "\n") !~# 'panel rework'

  " Both folds are still there on the way back.
  normal g
  Assert join(kimi#panel#_lines(), "\n") !~# 'panel rework',
        \ 'the state fold survived the round trip'
  call cursor(1, 1)
  call search('Working', 'W')
  normal za
  Assert join(kimi#panel#_lines(), "\n") =~# 'panel rework'
  normal g
  Assert join(kimi#panel#_lines(), "\n") !~# 'panel rework',
        \ 'and so did the project fold'

" ── what a reset restores ────────────────────────────────────────────────────

Execute (a reset puts the view, the folds and the tail back):
  call Panel()
  normal g
  call cursor(1, 1)
  call search('alpha', 'W')
  normal za
  AssertEqual 'place', kimi#panel#_grouping()

  call kimi#panel#_reset()
  call kimi#panel#open()
  AssertEqual 'state', kimi#panel#_grouping(), 'the default view is back'
  call kimi#session#_inject({'name': 'finished', 'status': 'closed'})
  call kimi#panel#refresh()
  Assert join(kimi#panel#_lines(), "\n") =~# '▸ Done',
        \ 'and Done is shut again'

Execute (the help block names the key):
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal ?
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# 'g by place', 'the help should offer the swap: ' . text
  Assert text =~# '/ filter',   'and the filter'
  normal g
  normal ?
  normal ?
  Assert join(kimi#panel#_lines(), "\n") =~# 'g by state',
        \ 'and say where it would take you from here'
