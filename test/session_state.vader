" Tests for the waiting signal: what the bottom of a kimi terminal is read
" as, and how that reaches kimi#session#status().
"
" The classifier is the whole reason the panel can group by state rather than
" by place, so it is tested on captured text first and against a real
" terminal second. There is no working pattern (the CLI has no documented
" working footer): working state is detected from terminal output activity,
" which the idle-timer tests cover.

Before:
  call kimi#session#_reset()
  call kimi#store#_reset()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  call kimi#store#_set_root(g:_dir)
  call kimi#cli#_set_cmd('sleep 30')

After:
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#session#_reset()
  call kimi#store#_reset()
  call kimi#cli#_reset()
  call delete(g:_dir, 'rf')

" ── reading the terminal ─────────────────────────────────────────────────────

Execute (a numbered choice means the session is waiting for you):
  AssertEqual 'waiting', kimi#session#_classify(
        \ join(['Do you want to make this edit to panel.vim?',
        \       '❯ 1. Yes',
        \       '  2. No, and tell kimi what to do differently'], "\n"))

Execute (a numbered list without the pointer is still a question):
  AssertEqual 'waiting', kimi#session#_classify(
        \ "Pick one:\n 1. Keep going\n 2. Stop")

Execute (a yes/no prompt is a question too):
  AssertEqual 'waiting', kimi#session#_classify('Overwrite it? (y/n)')

Execute (an empty prompt box says nothing either way):
  AssertEqual '', kimi#session#_classify("╭──────────╮\n│ >        │\n╰──────────╯")

Execute (nothing on the screen is not an answer):
  AssertEqual '', kimi#session#_classify('')

Execute (streaming output with no question is not a waiting signal):
  AssertEqual '', kimi#session#_classify(
        \ "✽ Frobnicating… (12s)\nmore output follows here")

" ── how it reaches the status ────────────────────────────────────────────────

Execute (a session whose terminal is asking a question is waiting):
  " A stand-in for kimi: fill the screen, print a permission prompt at the
  " bottom of it the way the CLI does, then stay alive. The blank lines
  " matter — s:term_tail() reads the bottom rows of the terminal, not the
  " last thing written to it.
  let script = g:_dir . '/asks.sh'
  call writefile(['#!/bin/sh', 'i=0',
        \ 'while [ $i -lt 60 ]; do echo; i=$((i+1)); done',
        \ 'echo "Do you want to proceed?"',
        \ 'echo "1. Yes"', 'exec sleep 30'], script)
  call setfperm(script, 'rwxr-xr-x')
  call kimi#cli#_set_cmd(script)

  let id = kimi#session#new('asker', 'new')
  for _ in range(100)
    call kimi#session#poll()
    if kimi#session#status(id) ==# 'waiting'
      break
    endif
    sleep 20m
  endfor
  AssertEqual 'waiting', kimi#session#status(id)
  AssertEqual 'waiting', kimi#session#get(id).status,
        \ 'the poll should have written it back to the record'

Execute (a session printing nothing falls back to the idle timer):
  let id = kimi#session#new('quiet', 'new')
  call kimi#session#poll()
  AssertEqual 'active', kimi#session#status(id),
        \ 'it produced output just now, whatever that output was'

  " Backdate the last observed output past the 30 second idle threshold.
  let rec = kimi#session#get(id)
  let rec.last_active = localtime() - 60
  AssertEqual 'idle', kimi#session#status(id),
        \ 'with nothing on screen and no recent output, it is idle'

Execute (a fabricated record still carries its status verbatim):
  call kimi#session#_inject({'id': 'fake', 'name': 'pinned',
        \ 'status': 'waiting', 'term_tail': 'Overwrite it? (y/n)'})
  AssertEqual 'waiting', kimi#session#status('fake'),
        \ 'there is no job behind it to read'

Execute (waiting is a live status, and sorts with the live ones):
  call kimi#session#_inject({'id': 'w', 'name': 'asking',
        \ 'status': 'waiting'})
  call kimi#session#_inject({'id': 'c', 'name': 'finished',
        \ 'status': 'closed'})
  AssertEqual 1, len(kimi#session#live()),
        \ 'a waiting session is running, so it is live'
  AssertEqual ['w', 'c'], map(copy(kimi#session#list()), {_, r -> r.id}),
        \ 'live sessions sort before finished ones'
