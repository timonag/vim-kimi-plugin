" Tests for kimi#input#complete() — the slash-command and @-file completion
" function used in the input window.
"
" findstart mode (a:findstart=1): scans the current line, returns the column
" where the completion token begins, or -3 to opt out.
"
" base mode (a:findstart=0): filters commands/skills/files by a:base prefix.
" Session data is seeded via kimi#input#collect_data() in the Before block.

Before:
  " No session is running, so collect_data() seeds the fallback set that
  " completion falls back to.
  call kimi#session#_reset()

  " Temp project dir with one skill in directory form and one flat, plus a
  " file for @-completion.
  let g:_test_dir = tempname()
  call mkdir(g:_test_dir . '/.kimi-code/skills/deploy', 'p')
  call mkdir(g:_test_dir . '/src', 'p')
  call writefile(['---'], g:_test_dir . '/.kimi-code/skills/deploy/SKILL.md')
  call writefile(['---'], g:_test_dir . '/.kimi-code/skills/review.md')
  call writefile(['package main'], g:_test_dir . '/src/main.go')

  let g:_test_orig_cwd = getcwd()
  execute 'cd ' . fnameescape(g:_test_dir)
  call kimi#input#collect_data()
  execute 'cd ' . fnameescape(g:_test_orig_cwd)

After:
  call kimi#session#_reset()
  call delete(g:_test_dir, 'rf')

" ── findstart: no trigger character ──────────────────────────────────────────

Execute (plain text with no trigger returns -3):
  enew
  call setline(1, 'hello world')
  call cursor(1, 11)
  AssertEqual -3, kimi#input#complete(1, '')

Execute (slash not at word start returns -3):
  enew
  call setline(1, 'a/new')
  call cursor(1, 5)
  AssertEqual -3, kimi#input#complete(1, '')

" ── findstart: slash trigger ─────────────────────────────────────────────────

Execute (slash at start of line triggers completion at column 0):
  enew
  call setline(1, '/new')
  call cursor(1, 4)
  AssertEqual 0, kimi#input#complete(1, '')

Execute (slash after a space triggers completion at slash position):
  enew
  call setline(1, 'hello /new')
  call cursor(1, 10)
  " 'hello /new' — '/' is at 0-indexed position 6
  AssertEqual 6, kimi#input#complete(1, '')

" ── findstart: @ trigger ─────────────────────────────────────────────────────

Execute (at-sign at line start triggers at column 0):
  enew
  call setline(1, '@src')
  call cursor(1, 4)
  AssertEqual 0, kimi#input#complete(1, '')

Execute (at-sign after text triggers at at-sign position):
  enew
  call setline(1, 'fix @src')
  call cursor(1, 8)
  " 'fix @src' — '@' is at 0-indexed position 4
  AssertEqual 4, kimi#input#complete(1, '')

" ── base mode: slash commands ────────────────────────────────────────────────

Execute (slash prefix returns built-in commands matching the prefix):
  let results = kimi#input#complete(0, '/mo')
  let words = map(copy(results), {_, c -> c.word})
  Assert index(words, '/model') >= 0, '/model not found in results for /mo'

Execute (slash prefix returns a skill in directory form):
  let results = kimi#input#complete(0, '/dep')
  let words = map(copy(results), {_, c -> c.word})
  Assert index(words, '/deploy') >= 0, '/deploy not found in results for /dep'

Execute (slash prefix returns a skill in flat form):
  let results = kimi#input#complete(0, '/rev')
  let words = map(copy(results), {_, c -> c.word})
  Assert index(words, '/review') >= 0, '/review not found in results for /rev'

Execute (slash prefix with no match returns empty list):
  let results = kimi#input#complete(0, '/zzz_no_such_command')
  AssertEqual [], results

Execute (slash prefix is case-sensitive — uppercase does not match):
  let results = kimi#input#complete(0, '/MO')
  AssertEqual [], results

" ── base mode: @ files ───────────────────────────────────────────────────────

Execute (at prefix returns matching files from the project):
  if executable('rg')
    execute 'cd ' . fnameescape(g:_test_dir)
    let results = kimi#input#complete(0, '@sr')
    execute 'cd ' . fnameescape(g:_test_orig_cwd)
    let words = map(copy(results), {_, c -> c.word})
    Assert index(words, '@src/main.go') >= 0,
          \ '@src/main.go not found in results for @sr'
  endif
