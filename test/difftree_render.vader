" Tests for how the diff tree is drawn: hierarchy, directory collapsing,
" status marks, colours, filtering and the empty states.

Before:
  call kimi#difftree#_reset()
  let g:_cwd  = getcwd()
  let g:_repo = tempname()
  call mkdir(g:_repo . '/src/api', 'p')
  call mkdir(g:_repo . '/deep/nested/only', 'p')
  let g:_g = 'git -C ' . shellescape(g:_repo) . ' '
  call system(g:_g . 'init -q -b main')
  call system(g:_g . 'config user.email t@t')
  call system(g:_g . 'config user.name test')
  call writefile(['x'], g:_repo . '/keep.txt')
  call system(g:_g . 'add -A')
  call system(g:_g . 'commit -qm base')
  call system(g:_g . 'checkout -q -b feature')
  call writefile(['x'], g:_repo . '/src/api/handler.go')
  call writefile(['x'], g:_repo . '/src/main.go')
  call writefile(['x'], g:_repo . '/deep/nested/only/leaf.txt')
  call system(g:_g . 'add -A')
  call system(g:_g . 'commit -qm work')
  call writefile(['dirty'], g:_repo . '/src/main.go')
  call writefile(['new'],   g:_repo . '/untracked.txt')
  " Keep the stores out of the plugin's data directory.
  let g:_stores = g:_repo . '-stores'
  call mkdir(g:_stores, 'p')
  call kimi#store#_set_root(g:_stores)
  execute 'cd ' . fnameescape(g:_repo)

  function! Text() abort
    return join(kimi#difftree#_lines(), "\n")
  endfunction

  " Write and source a stand-in nerdtree-git-plugin, so the runtime-preference
  " path can be exercised without the real plugin installed.
  let g:_stubdir = tempname()
  call mkdir(g:_stubdir . '/autoload', 'p')
  call writefile([
        \ 'function! gitstatus#getIndicator(status) abort',
        \ '  return "Z" . a:status[0]',
        \ 'endfunction'], g:_stubdir . '/autoload/gitstatus.vim')

  function! StubPlugin() abort
    execute 'source ' . fnameescape(g:_stubdir . '/autoload/gitstatus.vim')
  endfunction

  function! UnstubPlugin() abort
    if exists('*gitstatus#getIndicator')
      delfunction gitstatus#getIndicator
    endif
  endfunction

After:
  execute 'cd ' . fnameescape(g:_cwd)
  call UnstubPlugin()
  call kimi#store#_reset()
  call delete(g:_stores, 'rf')
  call kimi#difftree#_reset()
  call delete(g:_repo, 'rf')
  call delete(g:_stubdir, 'rf')
  silent! only

" ── hierarchy ────────────────────────────────────────────────────────────────

Execute (the header carries the base branch):
  call kimi#difftree#open()
  Assert kimi#difftree#_lines()[0] =~# '^Git Diff',  'expected a header'
  Assert kimi#difftree#_lines()[0] =~# 'main$',      'expected the base branch'

Execute (files nest under project, branch and directory nodes):
  " A worktree holds one branch, so there is no worktree level: project 0,
  " branch 2, directories 4 and deeper.
  call kimi#difftree#open()
  let t = Text()
  Assert t =~# '\n▾ ' . fnamemodify(g:_repo, ':t'), 'project node missing: ' . t
  Assert t =~# '\n  ▾ feature',                     'branch node missing: '  . t
  Assert t =~# '\n    ▾ src',                       'directory node missing: ' . t
  Assert t =~# 'handler\.go',                       'nested file missing'
  Assert t =~# 'untracked\.txt',                    'root-level file missing'

Execute (branch rows sit directly under the project):
  call kimi#difftree#open()
  let nodes = filter(copy(kimi#difftree#_nodes()),
        \ {_, n -> n.kind ==# 'branch'})
  Assert !empty(nodes), 'expected a branch node'
  AssertEqual '  ', nodes[0].indent
  Assert empty(filter(copy(kimi#difftree#_nodes()),
        \ {_, n -> n.kind ==# 'worktree'})),
        \ 'there is no worktree level any more'

Execute (a directory is indented under its parent):
  call kimi#difftree#open()
  let t = Text()
  Assert t =~# '    ▾ src\n      ▾ api\n',
        \ 'expected api nested under src: ' . t

" ── directory collapsing ─────────────────────────────────────────────────────

Execute (runs of single-child directories are merged into one node):
  call kimi#difftree#_set_collapse_dirs(1)
  call kimi#difftree#open()
  Assert Text() =~# '▾ deep/nested/only',
        \ 'expected the single-child run to collapse: ' . Text()

Execute (collapsing can be turned off):
  call kimi#difftree#_set_collapse_dirs(0)
  call kimi#difftree#open()
  call kimi#difftree#refresh()
  let t = Text()
  Assert t !~# 'deep/nested/only', 'the run should stay split'
  Assert t =~# '▾ deep',           'each level should be its own node: ' . t

Execute (a directory with files of its own is never collapsed):
  call kimi#difftree#_set_collapse_dirs(1)
  call kimi#difftree#open()
  " src holds main.go as well as the api/ subdirectory.
  Assert Text() !~# 'src/api', 'src has its own file and must not merge'

" ── status marks ─────────────────────────────────────────────────────────────

Execute (each file carries the right nerdtree-git-plugin glyph):
  call kimi#difftree#open()
  let t = Text()
  let staged    = kimi#difftree#indicator('Staged')
  let modified  = kimi#difftree#indicator('Modified')
  let untracked = kimi#difftree#indicator('Untracked')
  " handler.go was added on the branch and is clean in the working tree.
  Assert t =~# '\[' . staged . '\] handler\.go',
        \ 'expected a bracketed staged glyph: ' . t
  " main.go was added on the branch and then modified: both slots, separated.
  Assert t =~# '\[' . staged . '|' . modified . '\] main\.go',
        \ 'expected both slots with a separator: ' . t
  " untracked.txt has no branch state, so the first slot is kept blank rather
  " than collapsing to a lone glyph that could not say which column it is.
  Assert t =~# '\[ |' . untracked . '\] untracked\.txt',
        \ 'expected an empty first slot: ' . t

Execute (a single space separates the indicator field from the name):
  " Whatever the field holds -- one glyph, two, or none -- exactly one space
  " sits between its closing bracket and the name: no padding kept for
  " alignment across rows.
  call kimi#difftree#open()
  let t = Text()
  Assert t !~# '\]  ', 'expected a single space after the field: ' . t

Execute (the glyphs come from nerdtree-git-plugin when it is installed):
  " An autoload function has to be defined by a file whose name matches its
  " prefix, so the stand-in plugin is written out and sourced.
  call StubPlugin()
  AssertEqual 'ZM', kimi#difftree#indicator('Modified')
  AssertEqual 'ZS', kimi#difftree#indicator('Staged')
  call kimi#difftree#open()
  Assert Text() =~# 'ZS', 'the plugin glyph should be rendered: ' . Text()
  call UnstubPlugin()

Execute (the embedded copy is used when the plugin is absent):
  Assert !exists('*gitstatus#getIndicator'), 'precondition: plugin not loaded'
  " nerdtree-git-plugin's own utf-8 defaults.
  AssertEqual nr2char(10041), kimi#difftree#indicator('Modified')
  AssertEqual nr2char(10010), kimi#difftree#indicator('Staged')
  AssertEqual nr2char(10029), kimi#difftree#indicator('Untracked')
  AssertEqual nr2char(10140), kimi#difftree#indicator('Renamed')
  AssertEqual nr2char(9552),  kimi#difftree#indicator('Unmerged')
  AssertEqual nr2char(10006), kimi#difftree#indicator('Deleted')

Execute (ascii mode uses their ascii set, even with the plugin installed):
  call StubPlugin()
  call kimi#sidebar#_force_ascii(1)
  AssertEqual '*', kimi#difftree#indicator('Modified')
  AssertEqual '+', kimi#difftree#indicator('Staged')
  AssertEqual '!', kimi#difftree#indicator('Untracked')
  call kimi#difftree#open()
  Assert Text() =~# '\[+\] handler\.go', Text()
  call kimi#sidebar#_force_ascii(v:null)
  call UnstubPlugin()

Execute (nerd-font glyphs are used when that mode is on):
  let g:NERDTreeGitStatusUseNerdFonts = 1
  AssertEqual nr2char(61545), kimi#difftree#indicator('Modified')
  AssertEqual nr2char(61543), kimi#difftree#indicator('Staged')
  let g:NERDTreeGitStatusUseNerdFonts = 0

" ── colours ──────────────────────────────────────────────────────────────────

Execute (tree elements are highlighted):
  call kimi#difftree#open()
  call win_gotoid(bufwinid(kimi#difftree#bufnr()))
  let seen = {}
  for l in range(1, line('$'))
    for c in range(1, max([1, strlen(getline(l))]))
      let n = synIDattr(synID(l, c, 1), 'name')
      if !empty(n) | let seen[n] = 1 | endif
    endfor
  endfor
  for g in ['KimiDiffHeader', 'KimiDiffProject', 'KimiDiffBranch',
        \ 'KimiDiffDir', 'KimiDiffMarker', 'KimiDiffHelp']
    Assert has_key(seen, g), g . ' was not applied to any text'
  endfor

Execute (colours fall back to the groups NERDTree uses):
  call kimi#difftree#open()
  " Worktree, branch and directory must each be a different colour, and the
  " first two must not follow NERDTreeDir or they would collapse back into the
  " folder colour as soon as NERDTree's syntax file is sourced.
  Assert execute('highlight KimiDiffDir')    =~# 'links to Directory'
  Assert execute('highlight KimiDiffBranch') =~# 'links to Type'
  Assert execute('highlight KimiDiffLocal')  =~# 'links to Comment'
  Assert execute('highlight KimiDiffCommitted') =~# 'links to Normal'
  Assert execute('highlight KimiDiffHeader')    =~# 'links to Statement'

Execute (a branch with no upstream is greyed):
  " Whether a branch has a remote-tracking branch is not visible in the row's
  " text, so it is coloured with a text property rather than by :syntax.
  call kimi#difftree#open()
  Assert execute('highlight KimiDiffLocal') =~# 'links to Comment'
  if has('textprop')
    call win_gotoid(bufwinid(kimi#difftree#bufnr()))
    let marked = []
    for l in range(1, line('$'))
      if !empty(prop_list(l))
        call add(marked, getline(l))
      endif
    endfor
    " The fixture has no remote at all, so every branch row is local-only.
    Assert !empty(marked), 'expected a greyed branch row'
    for row in marked
      Assert row =~# '^  ', 'only branch rows are greyed, got [' . row . ']'
    endfor
  endif

Execute (status colours fall back to nerdtree-git-plugin's own sources):
  " Added and removed are excluded: they take an explicit green and red from
  " DiffAdd/DiffDelete rather than linking to a group.
  call kimi#difftree#open()
  Assert execute('highlight KimiDiffModified')  =~# 'links to Special'
  Assert execute('highlight KimiDiffUntracked') =~# 'links to Comment'
  Assert execute('highlight KimiDiffRenamed')   =~# 'links to Title'
  Assert execute('highlight KimiDiffUnmerged')  =~# 'links to Label'

Execute (nerdtree-git-plugin's own groups win when they exist):
  call kimi#difftree#open()
  Assert execute('highlight KimiDiffModified') =~# 'links to Special'
  highlight default link NERDTreeGitStatusModified Special
  call kimi#difftree#_relink()
  Assert execute('highlight KimiDiffModified')
        \ =~# 'links to NERDTreeGitStatusModified',
        \ 'the fallback should be upgraded to the plugin''s group'
  highlight link NERDTreeGitStatusModified NONE

Execute (a colour the user chose is never overwritten):
  call kimi#difftree#open()
  highlight! link KimiDiffStaged ErrorMsg
  highlight default link NERDTreeGitStatusStaged Function
  call kimi#difftree#_relink()
  Assert execute('highlight KimiDiffStaged') =~# 'links to ErrorMsg'
  highlight link KimiDiffStaged NONE
  highlight link NERDTreeGitStatusStaged NONE

Execute (both indicator columns are highlighted, not just the first):
  call kimi#difftree#open()
  call win_gotoid(bufwinid(kimi#difftree#bufnr()))
  let seen = {}
  for l in range(1, line('$'))
    for c in range(1, max([1, strlen(getline(l))]))
      let n = synIDattr(synID(l, c, 1), 'name')
      if !empty(n) | let seen[n] = 1 | endif
    endfor
  endfor
  " main.go is staged on the branch and modified in the tree: one row, two
  " different glyph groups. A ^-anchored pattern per column would only ever
  " colour the first.
  Assert has_key(seen, 'KimiDiffStaged'),   'first column not highlighted'
  Assert has_key(seen, 'KimiDiffModified'), 'second column not highlighted'
  Assert has_key(seen, 'KimiDiffCommitted'),   'clean filename not coloured'
  Assert has_key(seen, 'KimiDiffUncommitted'), 'dirty filename not coloured'

" ── filtering ────────────────────────────────────────────────────────────────

Execute (a filter narrows the tree to matching paths):
  call kimi#difftree#open()
  call kimi#difftree#set_filter('handler')
  let t = Text()
  Assert t =~# 'handler\.go',     'the match must survive'
  Assert t !~# 'untracked\.txt',  'non-matches must be hidden: ' . t
  Assert t !~# 'leaf\.txt',       'non-matches must be hidden'

Execute (the active filter is shown in the header):
  call kimi#difftree#open()
  call kimi#difftree#set_filter('handler')
  Assert kimi#difftree#_lines()[0] =~# '/handler',
        \ 'the header should show the filter: ' . kimi#difftree#_lines()[0]

Execute (filtering is case-insensitive for a lowercase pattern):
  call kimi#difftree#open()
  call kimi#difftree#set_filter('handler')
  let lower = Text()
  call kimi#difftree#set_filter('HANDLER')
  Assert lower =~# 'handler\.go', 'lowercase should match'
  Assert Text() !~# 'handler\.go', 'an uppercase pattern is taken literally'

Execute (a filter force-expands the directories holding a match):
  call kimi#difftree#open()
  call win_gotoid(bufwinid(kimi#difftree#bufnr()))
  " Collapse everything by folding the project node.
  call cursor(3, 1)
  normal za
  Assert Text() !~# 'handler\.go', 'precondition: the tree is folded shut'
  call kimi#difftree#set_filter('handler')
  Assert Text() =~# 'handler\.go',
        \ 'a match must be revealed regardless of fold state'

Execute (clearing the filter restores the whole tree):
  call kimi#difftree#open()
  call kimi#difftree#set_filter('handler')
  call kimi#difftree#set_filter('')
  let t = Text()
  Assert t =~# 'handler\.go'
  Assert t =~# 'untracked\.txt', 'everything comes back'

Execute (a filter matching nothing says so):
  call kimi#difftree#open()
  call kimi#difftree#set_filter('zzz-no-such-file')
  Assert Text() =~# 'no files match /zzz-no-such-file', Text()

" ── empty states ─────────────────────────────────────────────────────────────

Execute (a repository with no changes says so):
  call system(g:_g . 'checkout -q -f main')
  call system(g:_g . 'clean -qfd')
  call kimi#difftree#_reset()
  call kimi#difftree#open()
  Assert Text() =~# 'no changes vs main', Text()

Execute (outside a repository the panel says so):
  let plain = tempname()
  call mkdir(plain, 'p')
  execute 'cd ' . fnameescape(plain)
  call kimi#difftree#_reset()
  call kimi#difftree#open()
  Assert Text() =~# 'not a git repository', Text()
  execute 'cd ' . fnameescape(g:_repo)
  call delete(plain, 'rf')

Execute (with no resolvable base the panel explains how to set one):
  let plain = tempname()
  call mkdir(plain, 'p')
  execute 'cd ' . fnameescape(plain)
  call kimi#difftree#_reset()
  " Pretend we are in a repo but no base could be found.
  call kimi#difftree#open()
  Assert Text() =~# 'not a git repository\|no base branch', Text()
  execute 'cd ' . fnameescape(g:_repo)
  call delete(plain, 'rf')

Execute (worktree, branch and directory are three different colours):
  " The whole point: a folder, the worktree it lives in and the branch it is on
  " must never render in the same colour.
  call kimi#difftree#open()
  let seen = {}
  for g in ['KimiDiffBranch', 'KimiDiffDir', 'KimiDiffLocal']
    let seen[synIDattr(synIDtrans(hlID(g)), 'name')] = 1
  endfor
  AssertEqual 3, len(keys(seen)),
        \ 'each level must resolve to its own group, got ' . string(keys(seen))

Execute (they stay distinct once NERDTree's groups exist):
  call kimi#difftree#open()
  highlight default link NERDTreeDir Directory
  call kimi#difftree#_relink()
  let seen = {}
  for g in ['KimiDiffBranch', 'KimiDiffDir', 'KimiDiffLocal']
    let seen[synIDattr(synIDtrans(hlID(g)), 'name')] = 1
  endfor
  highlight link NERDTreeDir NONE
  AssertEqual 3, len(keys(seen)),
        \ 'loading NERDTree must not collapse them into one colour'

" ── the bracketed base ───────────────────────────────────────────────────────

Execute (a branch on the default base carries no prefix):
  call kimi#difftree#open()
  Assert Text() =~# '▾ feature\n', 'expected a bare branch row: ' . Text()
  Assert Text() !~# '\[main\]', 'the default base is not worth repeating'

Execute (an overridden branch is prefixed with its base):
  call system(g:_g . 'branch other main')
  call kimi#difftree#set_branch_base('feature', 'other')
  call kimi#difftree#open()
  Assert Text() =~# '▾ \[other\] feature',
        \ 'expected the base in brackets before the name: ' . Text()

Execute (the prefix disappears again when the override is cleared):
  call system(g:_g . 'branch other main')
  " Open first: set_branch_base() re-renders, but only when the panel is up.
  call kimi#difftree#open()
  call kimi#difftree#set_branch_base('feature', 'other')
  Assert Text() =~# '\[other\]', 'precondition: the prefix is there: ' . Text()
  call kimi#difftree#set_branch_base('feature', '')
  Assert Text() !~# '\[other\]', 'the prefix should be gone: ' . Text()

Execute (an override equal to the default shows no prefix):
  " Setting a branch to exactly what it already used is not an exception.
  call kimi#difftree#set_branch_base('feature', 'main')
  call kimi#difftree#open()
  AssertEqual 0, kimi#difftree#has_override('feature')
  Assert Text() !~# '\[main\]', Text()

Execute (the prefix keeps the worktree suffix intact):
  call system(g:_g . 'branch other main')
  call kimi#difftree#set_branch_base('feature', 'other')
  call kimi#difftree#open()
  let rows = filter(copy(kimi#difftree#_nodes()),
        \ {_, n -> n.kind ==# 'branch'})
  Assert !empty(rows)
  AssertEqual '[other] feature', rows[0].label

Execute (the prefix is highlighted as metadata, not as the branch name):
  call system(g:_g . 'branch other main')
  call kimi#difftree#set_branch_base('feature', 'other')
  call kimi#difftree#open()
  Assert execute('highlight KimiDiffBaseTag') =~# 'links to Identifier'
  call win_gotoid(bufwinid(kimi#difftree#bufnr()))
  let found = 0
  for l in range(1, line('$'))
    let c = match(getline(l), '\[other\]')
    if c >= 0
      let found = 1
      AssertEqual 'KimiDiffBaseTag', synIDattr(synID(l, c + 2, 1), 'name')
    endif
  endfor
  Assert found, 'expected a prefixed row to check'

" ── added is green, removed is red ───────────────────────────────────────────

Execute (the add and remove glyphs take their colour from DiffAdd/DiffDelete):
  " A headless Vim has no gui colours, so these assert on cterm.
  highlight clear KimiDiffStaged
  highlight clear KimiDiffDeleted
  highlight DiffAdd    ctermfg=10 ctermbg=0
  highlight DiffDelete ctermfg=9  ctermbg=0
  call kimi#difftree#_relink()
  AssertEqual '10', synIDattr(synIDtrans(hlID('KimiDiffStaged')), 'fg', 'cterm')
  AssertEqual '9',  synIDattr(synIDtrans(hlID('KimiDiffDeleted')), 'fg', 'cterm')

Execute (only the foreground is taken, never the background):
  " DiffAdd and DiffDelete usually carry a background; inheriting it would
  " paint a block behind the glyph.
  highlight clear KimiDiffStaged
  highlight clear KimiDiffDeleted
  highlight DiffAdd    ctermfg=10 ctermbg=0
  highlight DiffDelete ctermfg=9  ctermbg=0
  call kimi#difftree#_relink()
  AssertEqual '', synIDattr(synIDtrans(hlID('KimiDiffStaged')), 'bg', 'cterm')
  AssertEqual '', synIDattr(synIDtrans(hlID('KimiDiffDeleted')), 'bg', 'cterm')

Execute (added and removed are different colours from each other and modified):
  highlight clear KimiDiffStaged
  highlight clear KimiDiffDeleted
  highlight DiffAdd    ctermfg=10
  highlight DiffDelete ctermfg=9
  call kimi#difftree#_relink()
  call kimi#difftree#open()
  let seen = {}
  for g in ['KimiDiffStaged', 'KimiDiffDeleted', 'KimiDiffModified']
    let seen[synIDattr(synIDtrans(hlID(g)), 'fg', 'cterm')] = 1
  endfor
  AssertEqual 3, len(keys(seen)),
        \ 'add, remove and modify must be told apart, got ' . string(keys(seen))
