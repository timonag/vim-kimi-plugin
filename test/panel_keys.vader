" Tests for the panel window itself: its buffer options, the open verbs and
" the guarantee that hiding the panel never touches a running session.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  let g:_store_dir = tempname()
  call mkdir(g:_store_dir, 'p')
  call kimi#store#_set_root(g:_store_dir)
  call kimi#cli#_set_cmd('sleep 30')
  call kimi#store#_reset()

After:
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#cli#_reset()
  call kimi#store#_reset()
  call delete(g:_store_dir, 'rf')
  only

" ── window and buffer options ────────────────────────────────────────────────

Execute (the panel is a fixed-width scratch buffer):
  call kimi#panel#open()
  Assert kimi#panel#is_open(), 'the panel should be open'
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  AssertEqual 'nofile', &buftype
  AssertEqual 'hide',   &bufhidden
  AssertEqual 0, &modifiable, 'the panel must not be editable'
  AssertEqual 0, &buflisted,  'the panel must not appear in the buffer list'
  AssertEqual 1, &winfixwidth
  AssertEqual 0, &swapfile

Execute (the panel opens at its width on the left):
  call kimi#panel#_set_width(30)
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  AssertEqual 30, winwidth(0)
  AssertEqual 1,  winnr(), 'a left-anchored panel is the first window'
  call kimi#panel#_set_width(0)

Execute (toggle opens then hides the panel):
  call kimi#panel#toggle()
  Assert kimi#panel#is_open()
  call kimi#panel#toggle()
  Assert !kimi#panel#is_open()

Execute (opening an already-open panel focuses it instead of duplicating it):
  call kimi#panel#open()
  let before = winnr('$')
  call kimi#panel#open()
  AssertEqual before, winnr('$'), 'the panel must not be opened twice'
  AssertEqual bufwinid(kimi#panel#bufnr()), win_getid()

" ── hiding never ends a session ──────────────────────────────────────────────

Execute (closing the panel leaves every job running):
  let id = kimi#session#new('survivor')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#panel#open()
  call kimi#panel#close()
  Assert !kimi#panel#is_open(), 'the panel should be hidden'
  AssertEqual 'run', job_status(term_getjob(bufnr)),
        \ 'hiding the panel must not stop the session'
  Assert bufexists(bufnr), 'the terminal buffer should survive'
  AssertEqual 'active', kimi#session#status(id)

Execute (q in the panel hides it without touching the session):
  let id = kimi#session#new('survivor')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal q
  Assert !kimi#panel#is_open()
  AssertEqual 'run', job_status(term_getjob(bufnr))

" ── open verbs ───────────────────────────────────────────────────────────────

Execute (opening a hidden session brings it back into a window):
  let id = kimi#session#new('hidden')
  let bufnr = kimi#session#get(id).bufnr
  call win_execute(bufwinid(bufnr), 'hide')
  AssertEqual -1, bufwinid(bufnr), 'precondition: the session is hidden'
  call kimi#panel#open()
  call kimi#panel#open_session(id, 'here')
  Assert bufwinid(bufnr) != -1, 'the session should be visible again'

Execute (a visible session is jumped to, not opened a second time):
  let id = kimi#session#new('reused')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#panel#open()
  let before = winnr('$')
  call kimi#panel#open_session(id, 'here')
  AssertEqual before, winnr('$'), 'no duplicate window should be created'
  AssertEqual bufwinid(bufnr), win_getid(), 'the cursor should be in it'

Execute (split and vsplit each add one window):
  let id = kimi#session#new('splitter')
  let bufnr = kimi#session#get(id).bufnr
  call win_execute(bufwinid(bufnr), 'hide')
  call kimi#panel#open()
  let before = winnr('$')
  call kimi#panel#open_session(id, 'split')
  AssertEqual before + 1, winnr('$')
  AssertEqual bufnr, bufnr('%')

Execute (t opens the session in a new tab):
  let id = kimi#session#new('tabbed')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#panel#open()
  let tabs = tabpagenr('$')
  call kimi#panel#open_session(id, 'tab')
  AssertEqual tabs + 1, tabpagenr('$')
  AssertEqual bufnr, bufnr('%')
  tabclose

Execute (the panel window is never replaced by a session):
  let id = kimi#session#new('elsewhere')
  let bufnr = kimi#session#get(id).bufnr
  call win_execute(bufwinid(bufnr), 'hide')
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call kimi#panel#open_session(id, 'here')
  Assert kimi#panel#is_open(), 'the panel must still be open'
  AssertEqual kimi#panel#bufnr(),
        \ winbufnr(win_id2win(bufwinid(kimi#panel#bufnr()))),
        \ 'the panel window must still show the panel'

" ── cursor mapping ───────────────────────────────────────────────────────────

Execute (<CR> on a group node folds it rather than opening anything):
  call kimi#session#_inject({'name': 'child', 'status': 'active',
        \ 'project': '/w/beta', 'worktree': '/w/beta', 'branch': 'main'})
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(3, 1)
  execute "normal \<CR>"
  Assert join(kimi#panel#_lines(), "\n") !~# 'child',
        \ '<CR> on a project node should collapse it'

Execute (keys on a blank line do nothing):
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(2, 1)
  execute "normal \<CR>"
  normal i
  normal s
  Assert kimi#panel#is_open(), 'the panel should be unharmed'

" ── mouse ────────────────────────────────────────────────────────────────────

Execute (a double-click activates the row, as it does in NERDTree):
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  let m = maparg('<2-LeftMouse>', 'n', 0, 1)
  Assert !empty(m), 'double-click must be mapped: Vim does not derive it from <CR>'
  AssertEqual 1, m.buffer, 'the mapping must be local to the panel'
  Assert m.rhs =~# 'activate', 'expected it to run the same action as <CR>'

" ── hidden sessions ──────────────────────────────────────────────────────────

Execute (I lists the sessions nobody named, and hides them again):
  " Finished sessions: a live one is never hidden, whatever it is called.
  call kimi#session#_inject({'id': 'named', 'name': 'panel design',
        \ 'status': 'closed', 'project': '/w/beta', 'worktree': '/w/beta',
        \ 'branch': 'main'})
  call kimi#session#_inject({'id': 'anon', 'name': '', 'named': 0,
        \ 'status': 'closed', 'project': '/w/beta', 'worktree': '/w/beta',
        \ 'branch': 'main'})
  call kimi#panel#open()
  " The place view, where nothing is folded away to start with.
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))

  let lines = join(kimi#panel#_lines(), "\n")
  Assert lines =~# 'panel design', 'the named session should be listed'
  Assert lines !~# 'unnamed',      'the unnamed one should not be'

  normal I
  let lines = join(kimi#panel#_lines(), "\n")
  Assert lines =~# 'unnamed anon', 'I should reveal it, labelled by its id'

  normal I
  Assert join(kimi#panel#_lines(), "\n") !~# 'unnamed',
        \ 'I again should put it away'

Execute (lowercase i still opens a session in a split):
  let id = kimi#session#new('splitter')
  let bufnr = kimi#session#get(id).bufnr
  call win_execute(bufwinid(bufnr), 'hide')
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  let m = maparg('i', 'n', 0, 1)
  Assert m.rhs =~# "open('split')", 'i must still split, not toggle hidden'
  Assert !kimi#session#show_hidden(), 'i must not have toggled anything'

Execute (the help block names the I key):
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal ?
  Assert join(kimi#panel#_lines(), "\n") =~# 'I show hidden',
        \ 'the inline help should offer the toggle'
  normal ?

" ── starting a session ───────────────────────────────────────────────────────

" An input() prompt reached through a mapping cannot be answered with
" feedkeys(), so what n asks is tested on the path it calls.
Execute (n asks for a name, and nothing else):
  call feedkeys("a quick one\<CR>", 't')
  let id = kimi#session#spawn({'ask_name': 1, 'placement': 'new'})
  let rec = kimi#session#get(id)
  AssertEqual 'a quick one', rec.name
  AssertEqual 1,  rec.named
  AssertEqual '', rec.workspace, 'no branch was asked for'

Execute (a blank name is still an answer):
  call feedkeys("\<CR>", 't')
  let id = kimi#session#spawn({'ask_name': 1, 'placement': 'new'})
  AssertEqual '', kimi#session#get(id).name,
        \ 'it labels itself from its first message instead'
  AssertEqual 0,  kimi#session#get(id).named

Execute (n is the key that runs it):
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  Assert maparg('n', 'n', 0, 1).rhs =~# 'new()', 'n starts a session'

Execute (n asks one question, and a blank answer names nothing):
  call kimi#panel#_set_ask_name(0)
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal n
  call kimi#panel#_set_ask_name(1)
  AssertEqual 1, len(kimi#session#live())
  AssertEqual '', kimi#session#live()[0].name

Execute (N is the one that asks):
  " What it asks, and what each answer does, is test/session_workspace.vader.
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  let m = maparg('N', 'n', 0, 1)
  Assert m.rhs =~# 'new_asking', 'N should run the prompting path'
  Assert maparg('n', 'n', 0, 1).rhs =~# 'new()',
        \ 'and n the one that asks only the name'

Execute (the new session is the one the panel then opens):
  call kimi#panel#_set_ask_name(0)
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal n
  call kimi#panel#_set_ask_name(1)
  let id = kimi#session#live()[0].id
  Assert kimi#session#get(id).last_focus > 0,
        \ 'a session you just started is the one you were last in'
  Assert !kimi#sidebar#is_sidebar(bufwinid(kimi#session#get(id).bufnr)),
        \ 'and it opens in the main area, not inside the sidebar column'
