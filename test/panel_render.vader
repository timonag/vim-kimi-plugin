" Tests for the panel's rendering: the Group > Branch tree, the status
" glyphs, duplicate-name disambiguation and folding. Records are fabricated,
" so no Kimi process is ever started.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  let g:_store_dir = tempname()
  call mkdir(g:_store_dir, 'p')
  call kimi#store#_set_root(g:_store_dir)
  call kimi#store#_reset()
  " Work from an empty directory so the on-disk sessions of the real
  " project never leak into the assertions.
  let g:_orig_cwd = getcwd()
  let g:_empty = tempname()
  call mkdir(g:_empty, 'p')
  execute 'cd ' . fnameescape(g:_empty)

After:
  call kimi#panel#_reset()
  call kimi#session#_reset()
  execute 'cd ' . fnameescape(g:_orig_cwd)
  call kimi#store#_reset()
  call delete(g:_empty, 'rf')
  call delete(g:_store_dir, 'rf')
  only

" ── empty state ──────────────────────────────────────────────────────────────

Execute (an empty registry renders the placeholder, not an empty buffer):
  call kimi#panel#open()
  let lines = kimi#panel#_lines()
  Assert lines[0] =~# '^Kimi Sessions',   'expected a header'
  Assert lines[0] =~# '(0)$',               'expected a live count of 0'
  Assert index(lines, '  (no sessions)') >= 0,
        \ 'expected the empty placeholder, got ' . string(lines)

" ── grouping ─────────────────────────────────────────────────────────────────

Execute (sessions with no workspace nest Project > Branch):
  " The place view: g swaps to it, and these are its rows. Records with no
  " 'workspace' share a project node and split by branch only — the worktree
  " they happened to run in is not part of the grouping.
  call kimi#session#_inject({'name': 'panel design', 'status': 'active',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call kimi#session#_inject({'name': 'registry spike', 'status': 'idle',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'feature'})
  call kimi#session#_inject({'name': 'E947 repro', 'status': 'closed',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha-wt', 'branch': 'hotfix'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▾ alpha',        'project node missing: ' . text
  Assert text =~# '  ▾ main',     'branch node missing: ' . text
  Assert text =~# '  ▾ feature',  'second branch missing: ' . text
  Assert text =~# '  ▾ hotfix',   'third branch missing: ' . text
  Assert text =~# '    ● panel design',   'active session missing'
  Assert text =~# '    ○ registry spike', 'idle session missing'
  Assert text =~# '    ✗ E947 repro',     'closed session missing'

Execute (a workspace-backed session gets its own top-level group):
  " No real workspace to look up from this (non-git) cwd, so the tree falls
  " back to the record's own worktree/branch — exactly what a workspace
  " record would have supplied.
  call kimi#session#_inject({'name': 'codereview', 'status': 'active',
        \ 'project': '/w/datadog-agent',
        \ 'worktree': '/w/datadog-agent-macos-fleet-config',
        \ 'branch': 'pedro/macos-fleet-config',
        \ 'workspace': 'macos-fleet-config'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▾ datadog-agent-macos-fleet-config',
        \ 'workspace group missing: ' . text
  Assert text =~# '  ▾ pedro/macos-fleet-config', 'branch row missing: ' . text
  Assert text =~# '    ● codereview', 'session missing: ' . text
  Assert text !~# '▾ datadog-agent\n',
        \ 'a workspace-backed session must not share the bare repo group'

Execute (two worktrees of one repo share a single project node):
  call kimi#session#_inject({'name': 'a', 'status': 'active',
        \ 'project': '/w/repo', 'worktree': '/w/repo',    'branch': 'main'})
  call kimi#session#_inject({'name': 'b', 'status': 'active',
        \ 'project': '/w/repo', 'worktree': '/w/repo-wt', 'branch': 'topic'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  let lines = kimi#panel#_lines()
  let projects = filter(copy(lines), {_, l -> l =~# '^[▾▸] '})
  AssertEqual 1, len(projects),
        \ 'worktrees of one repo must share a project node: ' . string(projects)

Execute (the header counts live sessions only):
  call kimi#session#_inject({'name': 'a', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#session#_inject({'name': 'b', 'status': 'idle',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#session#_inject({'name': 'c', 'status': 'closed',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#panel#open()
  Assert kimi#panel#_lines()[0] =~# '(2)$',
        \ 'closed sessions must not be counted as live'

" ── glyphs ───────────────────────────────────────────────────────────────────

Execute (ascii mode swaps the glyph set):
  call kimi#sidebar#_force_ascii(1)
  AssertEqual '[A]', kimi#panel#icon('active')
  AssertEqual '[I]', kimi#panel#icon('idle')
  AssertEqual '[C]', kimi#panel#icon('closed')
  call kimi#session#_inject({'name': 'ascii one', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#panel#open()
  Assert join(kimi#panel#_lines(), "\n") =~# '\[A\] ascii one'
  call kimi#sidebar#_force_ascii(v:null)

Execute (a long name is trimmed from the end, keeping its opening words):
  call kimi#panel#_set_width(24)
  " An empty worktree and no created/last_focus time leave the row with no
  " suffix, so the label alone decides where it gets cut.
  call kimi#session#_inject({'name':
        \ 'ask me if something should be renamed before we ship',
        \ 'status': 'idle', 'worktree': '', 'created': 0})
  call kimi#panel#open()
  let rows = filter(kimi#panel#_lines(), {_, l -> l =~# 'ask me'})
  AssertEqual 1, len(rows)
  AssertEqual '  ○ ask me if somethin…', rows[0],
        \ 'expected the tail cut, opening words kept'
  call kimi#panel#_set_width(0)

" ── duplicate names ──────────────────────────────────────────────────────────

Execute (same-named sessions in one group get a display-only suffix):
  call kimi#session#_inject({'name': 'work', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#session#_inject({'name': 'work', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#panel#open()
  let rows = filter(kimi#panel#_lines(), {_, l -> l =~# 'work'})
  AssertEqual 2, len(rows), 'both should be listed: ' . string(rows)
  Assert rows[0] !~# '(2)', 'the first duplicate keeps its bare name'
  Assert rows[1] =~# 'work (2)', 'the second should be suffixed: ' . rows[1]
  " The stored names are untouched.
  let names = map(kimi#session#list(), {_, r -> r.name})
  AssertEqual ['work', 'work'], names

" ── folding ──────────────────────────────────────────────────────────────────

Execute (folding a project hides its children and persists across redraws):
  call kimi#session#_inject({'name': 'hidden me', 'status': 'active',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  Assert join(kimi#panel#_lines(), "\n") =~# 'hidden me'
  " Put the cursor on the project node and fold it.
  call cursor(3, 1)
  normal za
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▸ alpha',   'the project should be marked collapsed'
  Assert text !~# 'hidden me', 'collapsed children must not render'
  " A rebuild keeps the fold shut.
  call kimi#panel#refresh()
  Assert join(kimi#panel#_lines(), "\n") !~# 'hidden me'
  normal za
  Assert join(kimi#panel#_lines(), "\n") =~# 'hidden me',
        \ 'unfolding should bring the children back'

" ── colours ──────────────────────────────────────────────────────────────────
"
" The panel is coloured with NERDTree's palette so the two halves of the
" sidebar read as one thing. NERDTree's own highlight groups are preferred
" when they exist, so restyling NERDTree restyles the panel too.

Execute (the panel falls back to the groups NERDTree uses):
  " No precondition on NERDTreeDir existing: highlight groups are global and
  " leak between suites, and these three no longer depend on it anyway --
  " project, branch and the name follow their own colours or NERDTreeFile,
  " which nothing has defined at this point.
  call kimi#panel#open()
  Assert execute('highlight KimiSessionBranch') =~# 'links to Type'
  Assert execute('highlight KimiSessionName')     =~# 'links to Normal'
  Assert execute('highlight KimiSessionHeader')   =~# 'links to Statement'

Execute (NERDTree's own groups are picked up once they exist):
  " Session names follow NERDTreeFile; branch deliberately does not follow
  " any NERDTree group, so this is exercised through the name.
  call kimi#panel#open()
  Assert execute('highlight KimiSessionName') =~# 'links to Normal'
  " Stand in for NERDTree's syntax file being sourced.
  highlight default link NERDTreeFile Normal
  call kimi#panel#_relink()
  Assert execute('highlight KimiSessionName') =~# 'links to NERDTreeFile',
        \ 'the fallback should be upgraded to NERDTree''s group'
  highlight link NERDTreeFile NONE

Execute (project and branch keep their own colours when NERDTree loads):
  " They must not follow NERDTreeDir: two levels pointing at one group would
  " collapse into a single colour the moment NERDTree's syntax file was read.
  call kimi#panel#open()
  highlight default link NERDTreeDir Directory
  call kimi#panel#_relink()
  Assert execute('highlight KimiSessionProject') =~# 'links to Statement'
  Assert execute('highlight KimiSessionBranch')   =~# 'links to Type'
  highlight link NERDTreeDir NONE

Execute (project, branch and the session name are three different colours):
  call kimi#panel#open()
  let seen = {}
  for g in ['KimiSessionProject', 'KimiSessionBranch', 'KimiSessionName']
    let seen[synIDattr(synIDtrans(hlID(g)), 'name')] = 1
  endfor
  AssertEqual 3, len(keys(seen)),
        \ 'each level must resolve to its own group, got ' . string(keys(seen))

Execute (a colour the user chose is never overwritten):
  call kimi#panel#open()
  highlight! link KimiSessionName ErrorMsg
  highlight default link NERDTreeFile Normal
  call kimi#panel#_relink()
  Assert execute('highlight KimiSessionName') =~# 'links to ErrorMsg',
        \ 'a user override must survive the NERDTree upgrade'
  highlight link KimiSessionName NONE
  highlight link NERDTreeFile NONE

Execute (every panel element is highlighted):
  call kimi#session#_inject({'name': 'live', 'status': 'active',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#session#_inject({'name': 'gone', 'status': 'closed',
        \ 'worktree': '/w/x', 'branch': 'main'})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  let seen = {}
  for l in range(1, line('$'))
    for c in range(1, max([1, strlen(getline(l))]))
      let n = synIDattr(synID(l, c, 1), 'name')
      if !empty(n) | let seen[n] = 1 | endif
    endfor
  endfor
  for g in ['KimiSessionHeader', 'KimiSessionProject',
        \ 'KimiSessionBranch',
        \ 'KimiSessionMarker', 'KimiSessionActive',
        \ 'KimiSessionName', 'KimiSessionClosed',
        \ 'KimiSessionNameClosed', 'KimiSessionHelp']
    Assert has_key(seen, g), g . ' was not applied to any panel text'
  endfor
