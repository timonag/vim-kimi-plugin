" The panel must behave exactly as it always has for anyone who does not use
" NERDTree. Every stacking hook is guarded, so with g:NERDTree undefined the
" plugin must neither error nor change the layout it produces.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  " Make absolutely sure no stub from another suite is still defined.
  unlet! g:NERDTree
  unlet! t:NERDTreeBufName
  unlet! g:_fake_win
  let g:_store_dir = tempname()
  call mkdir(g:_store_dir, 'p')
  call kimi#store#_set_root(g:_store_dir)
  call kimi#cli#_set_cmd('sleep 30')
  call kimi#store#_reset()

After:
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#cli#_reset()
  call kimi#store#_reset()
  call delete(g:_store_dir, 'rf')
  silent! only

" ── NERDTree absent ──────────────────────────────────────────────────────────

Execute (the panel opens normally with no NERDTree present):
  Assert !exists('g:NERDTree'), 'precondition: NERDTree is not loaded'
  call kimi#panel#open()
  Assert kimi#panel#is_open()
  AssertEqual 35,
        \ winwidth(win_id2win(bufwinid(kimi#panel#bufnr()))),
        \ 'a standalone panel keeps the built-in width'

Execute (the panel is the leftmost window, as before):
  call kimi#panel#open()
  AssertEqual 1, win_screenpos(win_id2win(bufwinid(kimi#panel#bufnr())))[1]

Execute (stack() is a harmless no-op):
  call kimi#panel#open()
  let before = winlayout()
  call kimi#panel#stack()
  AssertEqual before, winlayout()

Execute (the panel is never height-fixed without a sidebar):
  call kimi#panel#open()
  AssertEqual 0, getwinvar(win_id2win(bufwinid(kimi#panel#bufnr())),
        \ '&winfixheight')

Execute (nerdtree_bufnr reports nothing to exclude):
  AssertEqual -1, kimi#panel#nerdtree_bufnr()

Execute (the NERDTree hooks tolerate being called with nothing loaded):
  call kimi#panel#open()
  call kimi#panel#_nerdtree_init()
  call kimi#panel#_win_closed('12345')
  sleep 50m
  Assert kimi#panel#is_open(), 'the panel should be unaffected'

Execute (the panel toggles cleanly, as before):
  call kimi#panel#toggle()
  Assert kimi#panel#is_open()
  call kimi#panel#toggle()
  Assert !kimi#panel#is_open()

Execute (a session still opens into the main area):
  call kimi#panel#open()
  let id = kimi#session#new('plain')
  call win_execute(bufwinid(kimi#session#get(id).bufnr), 'hide')
  call kimi#panel#open_session(id, 'split')
  let twin = bufwinid(kimi#session#get(id).bufnr)
  Assert twin != -1, 'the session should be visible'
  Assert win_screenpos(win_id2win(twin))[1]
        \ > win_screenpos(win_id2win(bufwinid(kimi#panel#bufnr())))[1],
        \ 'the session must open to the right of the panel'
  Assert kimi#panel#is_open(), 'the panel must survive'

Execute (hiding the panel still leaves the session running):
  let id = kimi#session#new('untouched')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#panel#open()
  call kimi#panel#close()
  AssertEqual 'run', job_status(term_getjob(bufnr))
