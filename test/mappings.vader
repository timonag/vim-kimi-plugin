" Tests for the default <leader> mappings. They are defined once when
" plugin/kimi.vim is sourced, so these only read what is already there.
"
" <leader> is not expanded by maparg(); with the default mapleader the
" mappings are literally \ko, \kn and so on.

Execute (<leader>ko focuses, picks or creates — the resolving verb):
  AssertEqual ':KimiOpen<CR>', maparg('\ko', 'n')

Execute (<leader>kn always starts a session):
  AssertEqual ':KimiNew<CR>', maparg('\kn', 'n')

Execute (the two are distinct commands, not aliases):
  Assert maparg('\ko', 'n') !=# maparg('\kn', 'n'),
        \ '\ko resolves a session; \kn never does'

Execute (the rest of the default set is still mapped):
  for [key, cmd] in [['\kt', ':KimiToggle<CR>'], ['\kx', ':KimiClose<CR>'],
        \ ['\kf', ':KimiFocus<CR>'], ['\ks', ':KimiSessions<CR>'],
        \ ['\kd', ':KimiDiff<CR>'], ['\kw', ':KimiWorkspaces<CR>'],
        \ ['\km', ':KimiModel<CR>'], ['\kr', ':KimiResume<CR>'],
        \ ['\ki', ':KimiInput<CR>'], ['\ke', ':KimiExplain<CR>']]
    AssertEqual cmd, maparg(key, 'n'), key . ' should be mapped'
  endfor

Execute (every mapped command exists):
  for cmd in ['KimiOpen', 'KimiNew', 'KimiToggle', 'KimiClose',
        \ 'KimiFocus', 'KimiSessions', 'KimiDiff', 'KimiWorkspaces',
        \ 'KimiModel', 'KimiResume', 'KimiInput', 'KimiExplain']
    AssertEqual 2, exists(':' . cmd), cmd . ' should be defined'
  endfor
