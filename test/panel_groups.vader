" Tests for the state view: the four groups the panel draws by default, what
" each row says, and how the Done tail folds, caps and hides.
"
" No terminal and no jobs: every record here is fabricated.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#store#_reset()
  let g:_saved_cwd = getcwd()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  call kimi#store#_set_root(g:_dir)
  " Somewhere with no sessions of its own: refresh() scans the directory
  " Vim is in, and this file is about fabricated records only.
  execute 'cd ' . fnameescape(g:_dir)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#store#_reset()
  call delete(g:_dir, 'rf')
  only

" ── the groups ───────────────────────────────────────────────────────────────

Execute (the state view is what the panel opens on):
  call kimi#panel#open()
  AssertEqual 'state', kimi#panel#_grouping()

Execute (sessions are grouped by what they are doing, in a fixed order):
  call kimi#session#_inject({'name': 'asking',   'status': 'waiting'})
  call kimi#session#_inject({'name': 'running',  'status': 'active'})
  call kimi#session#_inject({'name': 'sitting',  'status': 'idle'})
  call kimi#session#_inject({'name': 'finished', 'status': 'closed'})
  call kimi#panel#open()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▾ Needs you (1)', 'the waiting group is missing: ' . text
  Assert text =~# '▾ Working (1)',   'the working group is missing'
  Assert text =~# '▾ Idle (1)',      'the idle group is missing'
  Assert text =~# '▸ Done (1)',      'the done group is missing'

  let order = filter(kimi#panel#_lines(), {_, l -> l =~# '^[▾▸] '})
  Assert order[0] =~# 'Needs you', 'who needs me comes first: ' . string(order)
  Assert order[1] =~# 'Working'
  Assert order[2] =~# 'Idle'
  Assert order[3] =~# 'Done'

Execute (a group with nothing in it is not drawn at all):
  call kimi#session#_inject({'name': 'running', 'status': 'active'})
  call kimi#panel#open()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# 'Working (1)'
  Assert text !~# 'Needs you', 'nothing is waiting, so the group is absent'
  Assert text !~# 'Idle',      'nor is anything idle'
  Assert text !~# 'Done',      'and nothing has finished'

Execute (an empty registry still says so):
  call kimi#panel#open()
  Assert index(kimi#panel#_lines(), '  (no sessions)') >= 0

Execute (the waiting glyph marks the row):
  call kimi#session#_inject({'name': 'asking', 'status': 'waiting'})
  call kimi#panel#open()
  Assert join(kimi#panel#_lines(), "\n") =~# '✻ asking',
        \ 'a waiting session gets its own glyph'

Execute (ascii mode has a glyph for waiting too):
  call kimi#sidebar#_force_ascii(1)
  AssertEqual '[?]', kimi#panel#icon('waiting')
  call kimi#sidebar#_force_ascii(v:null)

" ── the header ───────────────────────────────────────────────────────────────

Execute (the header counts what is waiting, not what is live):
  call kimi#session#_inject({'name': 'asking one', 'status': 'waiting'})
  call kimi#session#_inject({'name': 'asking two', 'status': 'waiting'})
  call kimi#session#_inject({'name': 'running',    'status': 'active'})
  call kimi#panel#open()
  Assert kimi#panel#_lines()[0] =~# '2 waiting$',
        \ 'the header should lead with the question: ' . kimi#panel#_lines()[0]

Execute (with nothing waiting it counts live sessions, as it always has):
  call kimi#session#_inject({'name': 'running', 'status': 'active'})
  call kimi#session#_inject({'name': 'gone',    'status': 'closed'})
  call kimi#panel#open()
  Assert kimi#panel#_lines()[0] =~# '(1)$'

" ── the row ──────────────────────────────────────────────────────────────────

Execute (a row says where the session lives and how long ago it stirred):
  call kimi#session#_inject({'name': 'panel design', 'status': 'idle',
        \ 'worktree': '/w/alpha', 'branch': 'main',
        \ 'created': localtime() - 7200})
  call kimi#panel#open()
  let row = filter(kimi#panel#_lines(), {_, l -> l =~# 'panel design'})[0]
  Assert row =~# 'alpha', 'the row should name the workspace: ' . row
  Assert row =~# '2h$',   'and how old it is: ' . row
  AssertEqual 35, strchars(row), 'the suffix is flush with the panel edge'

Execute (a long label is trimmed rather than pushing the suffix off):
  call kimi#session#_inject({
        \ 'name': 'rework the whole session panel and everything under it',
        \ 'status': 'idle', 'worktree': '/w/alpha', 'branch': 'main'})
  call kimi#panel#open()
  let row = filter(kimi#panel#_lines(), {_, l -> l =~# 'alpha'})[0]
  AssertEqual 35, strchars(row)
  Assert row =~# '…', 'the label should be the part that gives: ' . row

Execute (the place view drops the workspace, which its parent rows already say):
  call kimi#session#_inject({'name': 'panel design', 'status': 'idle',
        \ 'project': '/w/alpha', 'worktree': '/w/alpha', 'branch': 'main',
        \ 'created': localtime() - 7200})
  call kimi#panel#open()
  call kimi#panel#_grouping('place')
  let row = filter(kimi#panel#_lines(), {_, l -> l =~# 'panel design'})[0]
  Assert row =~# '2h$',    'the age stays: ' . row
  Assert row !~# 'alpha ', 'the workspace does not: ' . row

" ── the Done tail ────────────────────────────────────────────────────────────

Execute (Done starts folded):
  call kimi#session#_inject({'name': 'finished', 'status': 'closed'})
  call kimi#panel#open()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▸ Done (1)', 'the tail starts shut: ' . text
  Assert text !~# 'finished',   'so its rows are not drawn'

Execute (and opens on the fold key like any other group):
  call kimi#session#_inject({'name': 'finished', 'status': 'closed'})
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('Done', 'W')
  normal za
  Assert join(kimi#panel#_lines(), "\n") =~# 'finished',
        \ 'unfolding Done should draw its rows'

Execute (Done stops after done_rows and says how many are left):
  call kimi#panel#_set_done_rows(3)
  for i in range(9)
    call kimi#session#_inject({'id': 'c' . i, 'name': 'done ' . i,
          \ 'status': 'closed'})
  endfor
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('Done', 'W')
  normal za
  let lines = kimi#panel#_lines()
  AssertEqual 3, len(filter(copy(lines), {_, l -> l =~# '✗ done '})),
        \ 'only done_rows of them are drawn'
  Assert join(lines, "\n") =~# '… 6 more', 'and the rest are counted'

Execute (activating that row draws the rest):
  call kimi#panel#_set_done_rows(3)
  for i in range(9)
    call kimi#session#_inject({'id': 'c' . i, 'name': 'done ' . i,
          \ 'status': 'closed'})
  endfor
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('Done', 'W')
  normal za
  call search('more', 'W')
  execute "normal \<CR>"
  let lines = kimi#panel#_lines()
  AssertEqual 9, len(filter(copy(lines), {_, l -> l =~# '✗ done '})),
        \ 'all of them, once asked for'
  Assert join(lines, "\n") !~# 'more'

Execute (Done reports the rows the hide rule is keeping out):
  call kimi#session#_inject({'id': 'kept', 'name': 'named one',
        \ 'status': 'closed'})
  call kimi#session#_inject({'id': 'anon', 'name': '', 'named': 0,
        \ 'status': 'closed'})
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  call cursor(1, 1)
  call search('Done', 'W')
  normal za
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# '▾ Done (1)',              'only the listed one is counted'
  Assert text =~# '… 1 hidden — I to show',  'the rest are reported: ' . text

Execute (Done is drawn even when every row in it is hidden):
  call kimi#session#_inject({'id': 'anon', 'name': '', 'named': 0,
        \ 'status': 'closed'})
  call kimi#panel#open()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# 'Done (0)', 'the tail must never be invisible: ' . text

Execute (I reveals them, and the note goes away with them):
  call kimi#session#_inject({'id': 'anon', 'name': '', 'named': 0,
        \ 'status': 'closed'})
  call kimi#panel#open()
  call win_gotoid(bufwinid(kimi#panel#bufnr()))
  normal I
  call cursor(1, 1)
  call search('Done', 'W')
  normal za
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# 'unnamed anon', 'I should reveal it: ' . text
  Assert text !~# 'hidden — I',   'and stop reporting a count'
