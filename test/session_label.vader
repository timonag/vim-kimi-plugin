" Tests for what a row is called.
"
" A name typed in the panel is the exception, not the identity. Without one,
" the CLI's own title labels a session — set with /title or generated — and
" the last prompt is the last resort.

Before:
  call kimi#session#_reset()
  call kimi#store#_reset()
  call kimi#panel#_reset()
  call kimi#cli#_reset()
  let g:_saved_cwd   = getcwd()
  let g:_root = resolve(tempname())
  let g:_dir  = g:_root . '/work'
  call mkdir(g:_dir, 'p')
  call kimi#store#_set_root(g:_root)
  let g:_home = g:_root . '/kimi-home'
  call mkdir(g:_home, 'p')
  let $KIMI_CODE_HOME = g:_home
  execute 'cd ' . fnameescape(g:_dir)

After:
  execute 'cd ' . fnameescape(g:_saved_cwd)
  call kimi#panel#_reset()
  call kimi#session#_reset()
  call kimi#store#_reset()
  call kimi#cli#_reset()
  let $KIMI_CODE_HOME = ''
  call delete(g:_root, 'rf')

" Register a CLI session {id} for g:_dir with the given state.json fields.
Execute (helper):
  function! CliSession(id, state) abort
    let l:dir = g:_home . '/sessions/wd_x/' . a:id
    call mkdir(l:dir . '/agents/main', 'p')
    call writefile([json_encode({'sessionId': a:id,
          \ 'sessionDir': l:dir, 'workDir': g:_dir})],
          \ g:_home . '/session_index.jsonl')
    call writefile([json_encode(a:state)], l:dir . '/state.json')
    call kimi#cli#_reset()
  endfunction

" ── the rule ─────────────────────────────────────────────────────────────────

Execute (a name someone typed wins):
  call kimi#session#_inject({'id': 'a', 'name': 'panel rework',
        \ 'snippet': 'rework the whole panel'})
  AssertEqual 'panel rework', kimi#session#label(kimi#session#get('a'))

Execute (with no name, the CLI title):
  call kimi#session#_inject({'id': 'a', 'name': '', 'named': 0,
        \ 'snippet': 'pick a diff base'})
  AssertEqual 'pick a diff base', kimi#session#label(kimi#session#get('a'))

Execute (with neither, the id, as it always was):
  call kimi#session#_inject({'id': '9c926d10-ad3d', 'name': '', 'named': 0})
  AssertEqual '(unnamed 9c926d10)',
        \ kimi#session#label(kimi#session#get('9c926d10-ad3d'))

" ── where the label comes from ───────────────────────────────────────────────

Execute (a scanned CLI session is labelled by its title):
  call CliSession('ses-1',
        \ {'id': 'ses-1', 'title': 'diff tree work', 'isCustomTitle': 1,
        \  'lastPrompt': 'rework the diff tree',
        \  'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})
  call kimi#session#refresh()
  let rec = kimi#session#get('ses-1')
  AssertEqual 'diff tree work',       rec.name
  AssertEqual 'rework the diff tree', rec.snippet
  AssertEqual 'diff tree work',       kimi#session#label(rec)

Execute (a CLI session with no title falls back to its last prompt):
  call CliSession('ses-2',
        \ {'id': 'ses-2', 'title': '', 'lastPrompt': 'pick a diff base',
        \  'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})
  call kimi#session#refresh()
  call kimi#session#toggle_hidden()
  let rec = kimi#session#get('ses-2')
  AssertEqual '',                rec.name
  AssertEqual 'pick a diff base', rec.snippet
  AssertEqual 'pick a diff base', kimi#session#label(rec)

Execute (a name from the store still wins over the CLI title):
  call CliSession('ses-3',
        \ {'id': 'ses-3', 'title': 'what the CLI calls it', 'isCustomTitle': 1,
        \  'lastPrompt': 'rework the diff tree',
        \  'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})
  call kimi#store#save({'version': 1, 'sessions':
        \ {'ses-3': {'name': 'what I called it', 'named': 1, 'cwd': g:_dir,
        \            'created': localtime()}}})
  call kimi#session#refresh()
  let rec = kimi#session#get('ses-3')
  AssertEqual 'what I called it',     kimi#session#label(rec)
  AssertEqual 'rework the diff tree', rec.snippet,
        \ 'the snippet is still read, in case the name is ever cleared'

Execute (a CLI session with nothing to say is labelled by its id):
  call CliSession('ses-4',
        \ {'id': 'ses-4', 'title': '', 'lastPrompt': '',
        \  'createdAt': (localtime() - 3600) * 1000, 'updatedAt': (localtime() - 3600) * 1000})
  call kimi#session#refresh()
  call kimi#session#toggle_hidden()
  AssertEqual '(unnamed ses-4)', kimi#session#label(kimi#session#get('ses-4'))

" ── in the panel ─────────────────────────────────────────────────────────────

Execute (two sessions labelled the same are told apart):
  call kimi#session#_inject({'id': 'a', 'name': '', 'named': 0,
        \ 'status': 'active', 'snippet': 'run the tests'})
  call kimi#session#_inject({'id': 'b', 'name': '', 'named': 0,
        \ 'status': 'active', 'snippet': 'run the tests'})
  call kimi#panel#open()
  let rows = filter(kimi#panel#_lines(), {_, l -> l =~# 'run the tests'})
  AssertEqual 2, len(rows)
  Assert rows[1] =~# '(2)', 'the second gets a display-only suffix: ' . rows[1]

Execute (an unlabelled session is readable in the panel while it runs):
  call kimi#session#_inject({'id': 'a', 'name': '', 'named': 0,
        \ 'status': 'waiting', 'snippet': 'pick a diff base'})
  call kimi#panel#open()
  let text = join(kimi#panel#_lines(), "\n")
  Assert text =~# 'pick a diff base',
        \ 'the session that needs you must never read as a hex id: ' . text
