" Tests for the global session registry: creation, status transitions,
" renaming, deletion and purging. A stand-in command is used so the tests
" never launch the real kimi CLI, and a fixture $KIMI_CODE_HOME stands in for
" the CLI's session index.

Before:
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#store#_reset()
  let g:_dir = tempname()
  call mkdir(g:_dir, 'p')
  call kimi#store#_set_root(g:_dir . '/store')
  let g:_home = g:_dir . '/kimi-home'
  call mkdir(g:_home, 'p')
  let $KIMI_CODE_HOME = g:_home
  call kimi#cli#_set_cmd('sleep 30')

After:
  " Stop and wipe whatever terminals the test left behind.
  for b in kimi#session#bufnrs()
    call kimi#session#stop_job(b)
    silent! execute 'bwipeout! ' . b
  endfor
  call kimi#session#_reset()
  call kimi#panel#_reset()
  call kimi#store#_reset()
  call kimi#cli#_reset()
  let $KIMI_CODE_HOME = ''
  call delete(g:_dir, 'rf')
  only

" ── identifiers ──────────────────────────────────────────────────────────────

Execute (uuid has the RFC-4122 v4 shape):
  let id = kimi#session#uuid()
  Assert id =~# '^\x\{8}-\x\{4}-4\x\{3}-[89ab]\x\{3}-\x\{12}$',
        \ 'not a v4 uuid: ' . id

Execute (successive uuids differ):
  Assert kimi#session#uuid() !=# kimi#session#uuid()

" ── creation ─────────────────────────────────────────────────────────────────

Execute (new() registers a live record with the given name):
  let id = kimi#session#new('panel design')
  Assert !empty(id), 'new() should return a session id'
  Assert kimi#session#exists(id)
  let rec = kimi#session#get(id)
  AssertEqual 'panel design', rec.name
  AssertEqual 'live',         rec.origin
  Assert rec.bufnr != -1,      'a live session must have a terminal buffer'
  AssertEqual 'active', kimi#session#status(id)

Execute (the terminal buffer is tagged with its session id):
  let id = kimi#session#new('tagged')
  let rec = kimi#session#get(id)
  AssertEqual id, getbufvar(rec.bufnr, 'kimi_session_id', '')

Execute (the scroll wheel scrolls the buffer instead of reaching the CLI):
  let id = kimi#session#new('wheel')
  let rec = kimi#session#get(id)
  execute 'buffer ' . rec.bufnr
  AssertEqual '<C-W>N<ScrollWheelUp>', maparg('<ScrollWheelUp>', 't')
  AssertEqual '<C-W>N<ScrollWheelDown>', maparg('<ScrollWheelDown>', 't')
  let info = maparg('<ScrollWheelUp>', 't', 0, 1)
  Assert info.buffer, 'the mapping must be buffer-local'

Execute (the name is persisted to the store immediately):
  let id = kimi#session#new('remembered')
  let data = kimi#store#load()
  AssertEqual 'remembered', data.sessions[id].name

Execute (two sessions run side by side in one tab):
  " Vader runs each suite in its own tab, so count the delta rather than
  " assuming a single tab page.
  let tabs = tabpagenr('$')
  let a = kimi#session#new('one')
  let b = kimi#session#new('two')
  Assert a !=# b, 'each session gets its own id'
  AssertEqual 2, len(kimi#session#live())
  AssertEqual tabs, tabpagenr('$'), 'a second session must not open a new tab'
  AssertEqual 'run', job_status(term_getjob(kimi#session#get(a).bufnr))
  AssertEqual 'run', job_status(term_getjob(kimi#session#get(b).bufnr))

" ── status ───────────────────────────────────────────────────────────────────

Execute (a running session with recent output is active):
  let id = kimi#session#new('busy')
  AssertEqual 'active', kimi#session#status(id)

Execute (a running session with no recent output is idle):
  let id = kimi#session#new('quiet')
  " Backdate the last observed output past the idle threshold.
  let rec = kimi#session#get(id)
  let rec.last_active = localtime() - 60
  AssertEqual 'idle', kimi#session#status(id)

Execute (a dead job flips the record to closed but keeps it listed):
  let id = kimi#session#new('dying')
  let bufnr = kimi#session#get(id).bufnr
  call job_stop(term_getjob(bufnr), 'kill')
  sleep 300m
  call kimi#session#poll()
  AssertEqual 'closed', kimi#session#status(id)
  Assert kimi#session#exists(id), 'the record must outlive its job'
  AssertEqual -1, kimi#session#get(id).bufnr
  Assert !bufexists(bufnr), 'the dead terminal buffer should be reaped'

Execute (an unknown id is closed, never an error):
  AssertEqual 'closed', kimi#session#status('no-such-session')

" ── rename ───────────────────────────────────────────────────────────────────

Execute (rename updates the registry and the store):
  let id = kimi#session#new('before')
  call kimi#session#rename(id, 'after')
  AssertEqual 'after', kimi#session#get(id).name
  AssertEqual 'after', kimi#store#load().sessions[id].name

Execute (renaming to an empty string is ignored):
  let id = kimi#session#new('keep me')
  call kimi#session#rename(id, '')
  AssertEqual 'keep me', kimi#session#get(id).name

" ── delete and purge ─────────────────────────────────────────────────────────

Execute (delete stops the job, wipes the buffer and keeps the record):
  let id = kimi#session#new('ending')
  let bufnr = kimi#session#get(id).bufnr
  call kimi#session#delete(id)
  Assert !bufexists(bufnr), 'the terminal buffer should be wiped'
  Assert kimi#session#exists(id), 'the record stays so it can be resumed'
  AssertEqual 'closed', kimi#session#get(id).status
  AssertEqual -1,       kimi#session#get(id).bufnr

Execute (purge removes the record and its stored name):
  let id = kimi#session#new('doomed')
  call kimi#session#purge(id)
  Assert !kimi#session#exists(id), 'purge must drop the record'
  Assert !has_key(kimi#store#load().sessions, id),
        \ 'purge must drop the stored name'

" ── listing ──────────────────────────────────────────────────────────────────

Execute (list puts live sessions before closed ones):
  let dead = kimi#session#_inject(
        \ {'name': 'old', 'status': 'closed', 'worktree': '/tmp/x'})
  let live = kimi#session#new('current')
  let names = map(kimi#session#list(), {_, r -> r.name})
  Assert index(names, 'current') < index(names, 'old'),
        \ 'live sessions sort first, got ' . string(names)

" ── sessions the CLI never persisted ─────────────────────────────────────────
"
" The CLI mints its own session ids and only writes them to the session index
" once a session has content. A session started here starts life under a
" provisional id; one the CLI knows nothing about is started fresh on resume.

Execute (a spawned session is not in the CLI's index yet):
  let id = kimi#session#new('never messaged')
  Assert !kimi#session#has_transcript(id),
        \ 'the stand-in CLI writes no index entry'
  AssertEqual '', kimi#cli#session_dir(id)

Execute (reopening a session with no index entry starts it fresh, keeping id/name):
  let id = kimi#session#new('never messaged')
  call kimi#session#delete(id)
  AssertEqual 'closed', kimi#session#status(id)
  " Must not fail the way `--session` on an unknown id would.
  AssertEqual id, kimi#session#resume(id)
  AssertEqual 'active',         kimi#session#status(id)
  AssertEqual 'never messaged', kimi#session#get(id).name
  Assert kimi#session#get(id).bufnr != -1

Execute (a session the CLI knows is resumed with --session):
  " Record argv from a stand-in CLI, then read back what actually arrived.
  let script = g:_dir . '/fake-kimi'
  let record = g:_dir . '/argv.txt'
  call writefile([
        \ '#!/bin/sh',
        \ 'printf "%s\n" "$@" > ' . shellescape(record),
        \ 'sleep 30',
        \ ], script)
  call setfperm(script, 'rwxr-xr-x')

  " Register the id on the CLI's side: an index entry plus its directory.
  let dir = g:_home . '/sessions/wd_x/ses-known'
  call mkdir(dir . '/agents/main', 'p')
  call writefile([json_encode({'sessionId': 'ses-known',
        \ 'sessionDir': dir, 'workDir': getcwd()})],
        \ g:_home . '/session_index.jsonl')
  call writefile([json_encode({'id': 'ses-known', 'title': 'known',
        \ 'createdAt': 1700000000000, 'updatedAt': 1700000000000})],
        \ dir . '/state.json')
  call kimi#cli#_reset()
  call kimi#cli#_set_cmd(script)

  call kimi#session#_inject({'id': 'ses-known', 'name': 'known',
        \ 'cwd': getcwd()})
  AssertEqual 'ses-known', kimi#session#resume('ses-known')
  for _ in range(40)
    if filereadable(record) | break | endif
    sleep 50m
  endfor
  Assert filereadable(record), 'the stand-in CLI should have run'
  AssertEqual ['--session', 'ses-known'], readfile(record),
        \ 'a known session is resumed by id'

Execute (a fresh spawn passes no arguments):
  let script = g:_dir . '/fake-kimi2'
  let record = g:_dir . '/argv2.txt'
  call writefile([
        \ '#!/bin/sh',
        \ 'printf "ran" > ' . shellescape(record),
        \ '[ $# -eq 0 ] || printf " %s" "$@" >> ' . shellescape(record),
        \ 'sleep 30',
        \ ], script)
  call setfperm(script, 'rwxr-xr-x')
  call kimi#cli#_set_cmd(script)

  let id = kimi#session#new('fresh one')
  for _ in range(40)
    if filereadable(record) | break | endif
    sleep 50m
  endfor
  Assert filereadable(record), 'the stand-in CLI should have run'
  AssertEqual 'ran', readfile(record)[0],
        \ 'a fresh session is a bare `kimi`: arguments would be torn by :terminal'

Execute (a spawned session is re-keyed onto the id the CLI mints):
  " The stand-in CLI does what the real one does: register its own session
  " in the index as soon as it starts, under an id of its own choosing.
  let script = g:_dir . '/adopting-kimi'
  call writefile([
        \ '#!/bin/sh',
        \ 'home=' . shellescape(g:_home),
        \ 'mkdir -p "$home/sessions/wd_x"',
        \ 'dir="$home/sessions/wd_x/ses-adopted"',
        \ 'mkdir -p "$dir/agents/main"',
        \ 'printf ''{"sessionId":"ses-adopted","sessionDir":"%s","workDir":"%s"}\n'' "$dir" ' . shellescape(getcwd()) . ' >> "$home/session_index.jsonl"',
        \ 'sleep 30',
        \ ], script)
  call setfperm(script, 'rwxr-xr-x')
  call kimi#cli#_set_cmd(script)

  let id = kimi#session#new('adopt me')
  Assert id !=# 'ses-adopted'
  for _ in range(50)
    call kimi#session#poll()
    if kimi#session#exists('ses-adopted')
      break
    endif
    sleep 100m
  endfor
  Assert !kimi#session#exists(id), 'the provisional id should be gone'
  Assert kimi#session#exists('ses-adopted'), 'the CLI id should be adopted'
  AssertEqual 'adopt me', kimi#session#get('ses-adopted').name,
        \ 'the name must survive the re-keying'

Execute (a stored session with no index entry is restored by refresh):
  let id = kimi#session#uuid()
  call kimi#store#put(id, {'name': 'from the store',
        \ 'cwd': getcwd(), 'project': getcwd(), 'worktree': getcwd(),
        \ 'branch': 'main', 'created': localtime()})
  call kimi#session#refresh()
  Assert kimi#session#exists(id),
        \ 'a named session with no index entry must survive a restart'
  AssertEqual 'from the store', kimi#session#get(id).name
  AssertEqual 'closed',         kimi#session#status(id)

Execute (stored sessions from another directory are not restored here):
  let id = kimi#session#uuid()
  call kimi#store#put(id, {'name': 'elsewhere', 'cwd': '/somewhere/else',
        \ 'project': '/somewhere/else', 'worktree': '/somewhere/else',
        \ 'branch': 'main', 'created': localtime()})
  call kimi#session#refresh()
  Assert !kimi#session#exists(id),
        \ 'only the current directory is in scope'

" ── the CLI argument vector ──────────────────────────────────────────────────
"
" Regression: the command used to be built as a string with shellescape()d
" arguments. :terminal runs no shell — it splits a string command on
" whitespace and keeps quote characters literally — so arguments arrived
" quoted or torn. The vector is built as a List so each argument passes
" through untouched.

Execute (argv is a list of unquoted arguments):
  let argv = kimi#session#_argv('44d05db9-62e9-439e-916b-982d1caefb18',
        \ 'panel design', 0)
  AssertEqual v:t_list, type(argv)
  AssertEqual ['sleep', '30'], argv
  for a in argv
    Assert a !~# "'", 'no argument may carry shell quotes: ' . a
  endfor

Execute (a resumed session passes --session with the id):
  let argv = kimi#session#_argv('abc-123', 'a name', 1)
  AssertEqual 'abc-123', argv[index(argv, '--session') + 1]
